{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workbench.invalid/schemas/workbench-pack-source-declarations-v1.schema.json",
  "title": "Workbench Pack Source Declarations V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schema_version", "declaration_set_id", "authority", "binding", "declarations", "summary", "limitations"],
  "properties": {
    "format": {"const": "workbench-pack-source-declarations-v1"},
    "schema_version": {"const": 1},
    "declaration_set_id": {"type": "string", "pattern": "^workbench-pack-source-declarations:sha256:[0-9a-f]{64}$"},
    "authority": {"type": "object"},
    "binding": {"type": "object"},
    "declarations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_declaration_id", "semantic_descriptor", "evidence_state", "attributes", "lifecycle", "provenance", "source_effect_id", "limitations"],
        "properties": {
          "source_declaration_id": {"type": "string", "pattern": "^workbench-pack-source-declaration:sha256:[0-9a-f]{64}$"},
          "semantic_descriptor": {"$ref": "#/$defs/semanticDescriptor"},
          "evidence_state": {"const": "static-candidate"},
          "attributes": {"type": "object"},
          "lifecycle": {"type": "object"},
          "provenance": {"type": "object"},
          "source_effect_id": {"type": ["string", "null"]},
          "limitations": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "summary": {"type": "object"},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "semanticDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "kind", "key"],
      "properties": {
        "domain": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "key": {"type": "object", "minProperties": 1}
      }
    }
  }
}
