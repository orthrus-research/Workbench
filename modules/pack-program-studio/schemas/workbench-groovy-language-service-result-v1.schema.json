{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workbench.invalid/schemas/workbench-groovy-language-service-result-v1.schema.json",
  "title": "Workbench Groovy language-service result V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schema_version",
    "result_id",
    "operation_class",
    "observed_at",
    "authority",
    "profile",
    "request",
    "program",
    "runtime",
    "service",
    "summary",
    "limitations",
    "horizons"
  ],
  "properties": {
    "format": {"const": "workbench-groovy-language-service-result-v1"},
    "schema_version": {"const": 1},
    "result_id": {"type": "string", "pattern": "^workbench-groovy-language-service-result:sha256:[0-9a-f]{64}$"},
    "operation_class": {"const": "read-only-network-observation"},
    "observed_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[^\\r\\n\\u0000]+Z$", "maxLength": 256},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["orchestrator", "compiler_observation", "runtime_inventory", "endpoint_identity", "runtime_effects", "construction"],
      "properties": {
        "orchestrator": {"const": "Workbench Pack Program Studio"},
        "compiler_observation": {"const": "GroovyScript embedded language server"},
        "runtime_inventory": {"const": "Workbench exact local byte inventory"},
        "endpoint_identity": {"const": "unavailable in the upstream protocol"},
        "runtime_effects": {"const": "none; Atlas observation not implied"},
        "construction": {"const": "none; Blueprints remains construction authority"}
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pack_program_profile_id", "pack_program_profile_sha256", "language_service_profile_id", "language_service_profile_path", "language_service_profile_sha256", "platform_profile_id", "groovyscript", "server_semantics", "runtime_layout", "bounds", "canary"],
      "properties": {
        "pack_program_profile_id": {"$ref": "#/$defs/nonempty"},
        "pack_program_profile_sha256": {"$ref": "#/$defs/digest"},
        "language_service_profile_id": {"$ref": "#/$defs/nonempty"},
        "language_service_profile_path": {"$ref": "#/$defs/nonempty"},
        "language_service_profile_sha256": {"$ref": "#/$defs/digest"},
        "platform_profile_id": {"$ref": "#/$defs/nonempty"},
        "groovyscript": {"$ref": "#/$defs/groovyscript"},
        "server_semantics": {"$ref": "#/$defs/serverSemantics"},
        "runtime_layout": {"$ref": "#/$defs/runtimeLayout"},
        "bounds": {"$ref": "#/$defs/bounds"},
        "canary": {"$ref": "#/$defs/canaryPolicy"}
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "runtime_root", "selected_paths", "all", "host", "port", "server_workspace_uri", "allow_remote", "connect_timeout_seconds", "diagnostic_timeout_seconds", "java", "runtime_receipt"],
      "properties": {
        "source": {"$ref": "#/$defs/nonempty"},
        "runtime_root": {"$ref": "#/$defs/nonempty"},
        "selected_paths": {
          "oneOf": [
            {"type": "null"},
            {"type": "array", "minItems": 1, "maxItems": 4096, "uniqueItems": true, "items": {"$ref": "#/$defs/nonempty"}}
          ]
        },
        "all": {"type": "boolean"},
        "host": {"type": "string", "minLength": 1, "maxLength": 1024},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "server_workspace_uri": {"type": "string", "pattern": "^file:", "maxLength": 16384},
        "allow_remote": {"type": "boolean"},
        "connect_timeout_seconds": {"type": "number", "minimum": 0.05, "maximum": 300},
        "diagnostic_timeout_seconds": {"type": "number", "minimum": 0.05, "maximum": 300},
        "java": {"type": ["string", "null"], "minLength": 1, "maxLength": 8192},
        "runtime_receipt": {"type": ["string", "null"], "minLength": 1, "maxLength": 8192}
      }
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": ["program_id", "source_sha256", "run_config_sha256", "pack_profile_id", "platform_profile_id", "physical_side", "packmode", "debug", "selected_files"],
      "properties": {
        "program_id": {"type": "string", "pattern": "^workbench-groovy-static-program:sha256:[0-9a-f]{64}$"},
        "source_sha256": {"$ref": "#/$defs/digest"},
        "run_config_sha256": {"$ref": "#/$defs/digest"},
        "pack_profile_id": {"$ref": "#/$defs/nonempty"},
        "platform_profile_id": {"$ref": "#/$defs/nonempty"},
        "physical_side": {"const": "client"},
        "packmode": {"type": ["string", "null"], "minLength": 1, "maxLength": 1024},
        "debug": {"type": "boolean"},
        "selected_files": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"$ref": "#/$defs/selectedFile"}}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_id", "root", "run_config_path", "run_config_sha256", "groovyscript_artifact", "mod_graph", "class_cache", "java", "launch_receipt", "endpoint_binding"],
      "properties": {
        "runtime_id": {"type": "string", "pattern": "^workbench-groovy-language-runtime:sha256:[0-9a-f]{64}$"},
        "root": {"$ref": "#/$defs/nonempty"},
        "run_config_path": {"$ref": "#/$defs/nonempty"},
        "run_config_sha256": {"$ref": "#/$defs/digest"},
        "groovyscript_artifact": {"$ref": "#/$defs/artifact"},
        "mod_graph": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mod_graph_id", "artifacts", "artifact_count", "total_bytes"],
          "properties": {
            "mod_graph_id": {"type": "string", "pattern": "^workbench-groovy-runtime-mod-graph:sha256:[0-9a-f]{64}$"},
            "artifacts": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"$ref": "#/$defs/artifact"}},
            "artifact_count": {"type": "integer", "minimum": 1, "maximum": 4096},
            "total_bytes": {"type": "integer", "minimum": 1}
          }
        },
        "class_cache": {"$ref": "#/$defs/classCache"},
        "java": {"$ref": "#/$defs/javaIdentity"},
        "launch_receipt": {"$ref": "#/$defs/launchReceipt"},
        "endpoint_binding": {"const": "caller-context-only; upstream endpoint has no identity challenge"}
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "endpoint", "workspace_uri", "capabilities", "files", "failure", "transcript"],
      "properties": {
        "state": {"enum": ["completed", "partial", "blocked"]},
        "endpoint": {"$ref": "#/$defs/endpoint"},
        "workspace_uri": {"type": "string", "pattern": "^file:", "maxLength": 16384},
        "capabilities": {"type": ["object", "null"]},
        "files": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/checkedFile"}},
        "failure": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/failure"}
          ]
        },
        "transcript": {"$ref": "#/$defs/transcript"}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "compiler_state", "selected_files", "checked_files", "diagnostics", "severity_counts", "file_states", "runtime_binding"],
      "properties": {
        "status": {"enum": ["ready", "attention", "blocked"]},
        "compiler_state": {"enum": ["no-diagnostics", "diagnostics", "inconclusive", "blocked"]},
        "selected_files": {"type": "integer", "minimum": 1, "maximum": 4096},
        "checked_files": {"type": "integer", "minimum": 0, "maximum": 4096},
        "diagnostics": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "severity_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "file_states": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "runtime_binding": {"const": "unavailable-upstream-protocol"}
      }
    },
    "limitations": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 8192}},
    "horizons": {"type": "array", "maxItems": 256, "items": {"type": "object"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nonempty": {"type": "string", "minLength": 1, "maxLength": 8192},
    "groovyscript": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "artifact_filename", "artifact_sha256", "artifact_size", "source_commit"],
      "properties": {
        "version": {"type": "string", "minLength": 1, "maxLength": 256},
        "artifact_filename": {"type": "string", "minLength": 1, "maxLength": 1024},
        "artifact_sha256": {"$ref": "#/$defs/digest"},
        "artifact_size": {"type": "integer", "minimum": 1, "maximum": 4294967296},
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "serverSemantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transport", "default_host", "default_port", "runtime_side", "start_property", "compile_trigger", "diagnostic_method", "text_document_sync", "compilation_phase", "endpoint_identity_protocol"],
      "properties": {
        "transport": {"const": "lsp-jsonrpc-tcp"},
        "default_host": {"type": "string", "minLength": 1, "maxLength": 1024},
        "default_port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "runtime_side": {"const": "client"},
        "start_property": {"type": "string", "minLength": 1, "maxLength": 1024},
        "compile_trigger": {"const": "textDocument/documentSymbol"},
        "diagnostic_method": {"const": "textDocument/publishDiagnostics"},
        "text_document_sync": {"const": "full"},
        "compilation_phase": {"const": "canonicalization"},
        "endpoint_identity_protocol": {"const": "unavailable"}
      }
    },
    "runtimeLayout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_relative_path", "mods_directory", "groovy_directory", "run_config", "cache_directory"],
      "properties": {
        "artifact_relative_path": {"$ref": "#/$defs/nonempty"},
        "mods_directory": {"$ref": "#/$defs/nonempty"},
        "groovy_directory": {"$ref": "#/$defs/nonempty"},
        "run_config": {"$ref": "#/$defs/nonempty"},
        "cache_directory": {"$ref": "#/$defs/nonempty"}
      }
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_files", "max_source_bytes", "max_total_source_bytes", "max_header_bytes", "max_message_bytes", "max_transcript_messages", "max_diagnostics", "max_runtime_artifacts", "max_runtime_artifact_bytes"],
      "properties": {
        "max_files": {"type": "integer", "minimum": 1, "maximum": 4096},
        "max_source_bytes": {"type": "integer", "minimum": 1, "maximum": 67108864},
        "max_total_source_bytes": {"type": "integer", "minimum": 1, "maximum": 536870912},
        "max_header_bytes": {"type": "integer", "minimum": 1024, "maximum": 1048576},
        "max_message_bytes": {"type": "integer", "minimum": 1024, "maximum": 268435456},
        "max_transcript_messages": {"type": "integer", "minimum": 16, "maximum": 1000000},
        "max_diagnostics": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "max_runtime_artifacts": {"type": "integer", "minimum": 1, "maximum": 4096},
        "max_runtime_artifact_bytes": {"type": "integer", "minimum": 1, "maximum": 4294967296}
      }
    },
    "canaryPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prefix", "required_severity"],
      "properties": {
        "prefix": {"type": "string", "minLength": 1, "maxLength": 1024},
        "required_severity": {"const": 1}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size"],
      "properties": {
        "path": {"$ref": "#/$defs/nonempty"},
        "sha256": {"$ref": "#/$defs/digest"},
        "size": {"type": "integer", "minimum": 1, "maximum": 4294967296}
      }
    },
    "selectedFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "absolute_path", "server_uri", "sha256", "size", "stage", "execution_state"],
      "properties": {
        "path": {"$ref": "#/$defs/nonempty"},
        "absolute_path": {"$ref": "#/$defs/nonempty"},
        "server_uri": {"type": "string", "pattern": "^file:", "maxLength": 16384},
        "sha256": {"$ref": "#/$defs/digest"},
        "size": {"type": "integer", "minimum": 0, "maximum": 67108864},
        "stage": {"type": "string", "minLength": 1, "maxLength": 1024},
        "execution_state": {"enum": ["enabled", "conditional", "excluded"]}
      }
    },
    "classCache": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "path", "file_count", "total_bytes", "tree_sha256", "cache_version", "content_addressed_by_upstream", "upstream_identity_inputs"],
      "properties": {
        "state": {"enum": ["present", "absent"]},
        "path": {"$ref": "#/$defs/nonempty"},
        "file_count": {"type": "integer", "minimum": 0, "maximum": 250000},
        "total_bytes": {"type": "integer", "minimum": 0, "maximum": 4294967296},
        "tree_sha256": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "cache_version": {"const": 4},
        "content_addressed_by_upstream": {"const": false},
        "upstream_identity_inputs": {"const": ["source last-modified time", "Java version"]}
      }
    },
    "javaIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "sha256", "size", "path", "version_output"],
      "properties": {
        "state": {"enum": ["not-supplied", "caller-supplied-exact-bytes"]},
        "sha256": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "size": {"type": ["integer", "null"], "minimum": 1, "maximum": 4294967296},
        "path": {"type": ["string", "null"], "minLength": 1, "maxLength": 8192},
        "version_output": {"type": ["string", "null"], "minLength": 1, "maxLength": 8192}
      }
    },
    "launchReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "path", "sha256", "size", "format", "receipt_id", "semantic_validation"],
      "properties": {
        "state": {"enum": ["not-supplied", "caller-supplied-context"]},
        "path": {"type": ["string", "null"], "minLength": 1, "maxLength": 8192},
        "sha256": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "size": {"type": ["integer", "null"], "minimum": 1},
        "format": {"type": ["string", "null"], "minLength": 1, "maxLength": 8192},
        "receipt_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 8192},
        "semantic_validation": {"enum": ["not-performed", "not-performed; endpoint protocol cannot present this receipt"]}
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "port", "transport", "connect_ms", "identity_binding"],
      "properties": {
        "host": {"type": "string", "minLength": 1, "maxLength": 1024},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "transport": {"const": "lsp-jsonrpc-tcp"},
        "connect_ms": {"type": ["integer", "null"], "minimum": 0},
        "identity_binding": {"const": "unavailable-upstream-protocol"}
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "message", "checked_files"],
      "properties": {
        "kind": {"type": "string", "minLength": 1, "maxLength": 256},
        "message": {"type": "string", "minLength": 1, "maxLength": 2048},
        "checked_files": {"type": "integer", "minimum": 0, "maximum": 4096}
      }
    },
    "checkedFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "server_uri", "sha256", "size", "stage", "execution_state", "state", "canary", "diagnostics", "diagnostic_count", "symbol_count", "request_error", "compile_latency_ms"],
      "properties": {
        "path": {"$ref": "#/$defs/nonempty"},
        "server_uri": {"type": "string", "pattern": "^file:", "maxLength": 16384},
        "sha256": {"$ref": "#/$defs/digest"},
        "size": {"type": "integer", "minimum": 0, "maximum": 67108864},
        "stage": {"type": "string", "minLength": 1, "maxLength": 1024},
        "execution_state": {"enum": ["enabled", "conditional", "excluded"]},
        "state": {"enum": ["no-diagnostics", "diagnostics", "inconclusive"]},
        "canary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "diagnostic_count", "latency_ms"],
          "properties": {
            "state": {"const": "confirmed"},
            "diagnostic_count": {"type": "integer", "minimum": 1, "maximum": 1000000},
            "latency_ms": {"type": "integer", "minimum": 0}
          }
        },
        "diagnostics": {"type": "array", "maxItems": 1000000, "items": {"$ref": "#/$defs/diagnostic"}},
        "diagnostic_count": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "symbol_count": {"type": ["integer", "null"], "minimum": 0},
        "request_error": {"type": ["string", "null"], "minLength": 1, "maxLength": 2048},
        "compile_latency_ms": {"type": "integer", "minimum": 0}
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["diagnostic_id", "range", "severity", "code", "source", "message"],
      "properties": {
        "diagnostic_id": {"type": "string", "pattern": "^workbench-groovy-diagnostic:sha256:[0-9a-f]{64}$"},
        "range": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {
            "start": {"$ref": "#/$defs/position"},
            "end": {"$ref": "#/$defs/position"}
          }
        },
        "severity": {"type": ["integer", "null"], "minimum": 1, "maximum": 4},
        "code": {"type": ["string", "integer", "null"], "minLength": 1, "maxLength": 256},
        "source": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
        "message": {"type": "string", "minLength": 1, "maxLength": 8192}
      }
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["line", "character"],
      "properties": {
        "line": {"type": "integer", "minimum": 0},
        "character": {"type": "integer", "minimum": 0}
      }
    },
    "transcript": {
      "type": "object",
      "additionalProperties": false,
      "required": ["messages", "message_count", "method_counts", "transcript_sha256"],
      "properties": {
        "messages": {"type": "array", "maxItems": 1000000, "items": {"$ref": "#/$defs/transcriptMessage"}},
        "message_count": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "method_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
        "transcript_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "transcriptMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "direction", "kind", "method", "id", "size", "sha256"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "direction": {"enum": ["inbound", "outbound"]},
        "kind": {"enum": ["request", "notification", "response", "error-response"]},
        "method": {"type": ["string", "null"], "minLength": 1, "maxLength": 1024},
        "id": {"type": ["integer", "string", "null"]},
        "size": {"type": "integer", "minimum": 1, "maximum": 268435456},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
