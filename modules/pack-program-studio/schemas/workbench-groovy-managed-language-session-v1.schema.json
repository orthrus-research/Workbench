{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workbench.invalid/schemas/workbench-groovy-managed-language-session-v1.schema.json",
  "title": "Workbench Groovy managed language-session receipt V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schema_version", "receipt_id", "session_id", "operation_class", "started_at", "ready_at", "ended_at", "state", "outcome", "profile", "program", "runtime", "launch", "endpoint", "readiness", "overlays", "handoff", "shutdown", "events", "limitations"],
  "properties": {
    "format": {"const": "workbench-groovy-managed-language-session-v1"},
    "schema_version": {"const": 1},
    "receipt_id": {"type": "string", "pattern": "^workbench-groovy-managed-language-session:sha256:[0-9a-f]{64}$"},
    "session_id": {"$ref": "#/$defs/sessionId"},
    "operation_class": {"const": "local-mutation"},
    "started_at": {"$ref": "#/$defs/nonempty"},
    "ready_at": {"oneOf": [{"$ref": "#/$defs/nonempty"}, {"type": "null"}]},
    "ended_at": {"$ref": "#/$defs/nonempty"},
    "state": {"enum": ["complete", "blocked"]},
    "outcome": {"$ref": "#/$defs/nonempty"},
    "profile": {"$ref": "#/$defs/profile"},
    "program": {"$ref": "#/$defs/program"},
    "runtime": {"$ref": "#/$defs/runtime"},
    "launch": {"$ref": "#/$defs/launch"},
    "endpoint": {"$ref": "#/$defs/endpoint"},
    "readiness": {"$ref": "#/$defs/readiness"},
    "overlays": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/overlay"}},
    "handoff": {"oneOf": [{"type": "null"}, {"type": "object"}]},
    "shutdown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "graceful_attempted", "forced", "orphaned_pids"],
      "properties": {
        "reason": {"$ref": "#/$defs/nonempty"},
        "graceful_attempted": {"type": "boolean"},
        "forced": {"type": "boolean"},
        "orphaned_pids": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}}
      }
    },
    "events": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size", "count"],
      "properties": {
        "path": {"$ref": "#/$defs/nonempty"},
        "sha256": {"$ref": "#/$defs/digest"},
        "size": {"type": "integer", "minimum": 0},
        "count": {"type": "integer", "minimum": 1}
      }
    },
    "limitations": {"$ref": "#/$defs/limitations"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nonempty": {"type": "string", "minLength": 1, "maxLength": 16384},
    "sessionId": {"type": "string", "pattern": "^workbench-groovy-language-session:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pack_program_profile_id", "pack_program_profile_sha256", "language_service_profile_id", "language_service_profile_sha256", "managed_session_profile_id", "managed_session_profile_sha256", "platform_profile_id"],
      "properties": {
        "pack_program_profile_id": {"$ref": "#/$defs/nonempty"},
        "pack_program_profile_sha256": {"$ref": "#/$defs/digest"},
        "language_service_profile_id": {"$ref": "#/$defs/nonempty"},
        "language_service_profile_sha256": {"$ref": "#/$defs/digest"},
        "managed_session_profile_id": {"$ref": "#/$defs/nonempty"},
        "managed_session_profile_sha256": {"$ref": "#/$defs/digest"},
        "platform_profile_id": {"$ref": "#/$defs/nonempty"}
      }
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": ["program_id", "source_sha256", "source_root", "workspace_uri", "server_workspace_uri"],
      "properties": {
        "program_id": {"$ref": "#/$defs/nonempty"},
        "source_sha256": {"$ref": "#/$defs/digest"},
        "source_root": {"$ref": "#/$defs/nonempty"},
        "workspace_uri": {"type": "string", "pattern": "^file:", "maxLength": 16384},
        "server_workspace_uri": {"type": "string", "pattern": "^file:", "maxLength": 16384}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_id", "root", "mod_graph_id", "java_sha256", "launch_receipt_path", "launch_receipt_sha256", "launch_receipt_size"],
      "properties": {
        "runtime_id": {"$ref": "#/$defs/nonempty"},
        "root": {"$ref": "#/$defs/nonempty"},
        "mod_graph_id": {"$ref": "#/$defs/nonempty"},
        "java_sha256": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "launch_receipt_path": {"$ref": "#/$defs/nonempty"},
        "launch_receipt_sha256": {"$ref": "#/$defs/digest"},
        "launch_receipt_size": {"type": "integer", "minimum": 1, "maximum": 67108864}
      }
    },
    "launch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "command_sha256", "cwd", "launcher_path", "launcher_sha256", "launcher_size", "launcher_pid", "launcher_returncode", "client_processes", "ownership"],
      "properties": {
        "command": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/nonempty"}},
        "command_sha256": {"$ref": "#/$defs/digest"},
        "cwd": {"$ref": "#/$defs/nonempty"},
        "launcher_path": {"$ref": "#/$defs/nonempty"},
        "launcher_sha256": {"$ref": "#/$defs/digest"},
        "launcher_size": {"type": "integer", "minimum": 1},
        "launcher_pid": {"type": ["integer", "null"], "minimum": 1},
        "launcher_returncode": {"type": ["integer", "null"]},
        "client_processes": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pid", "tracker", "creation_date"],
            "properties": {
              "pid": {"type": "integer", "minimum": 1},
              "tracker": {"$ref": "#/$defs/nonempty"},
              "creation_date": {"type": ["string", "null"], "minLength": 1, "maxLength": 256}
            }
          }
        },
        "ownership": {"enum": ["session-owned", "incomplete"]}
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "port", "transport", "allocation", "connection_model", "identity_binding", "route", "upstream"],
      "properties": {
        "host": {"const": "127.0.0.1"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "transport": {"const": "lsp-jsonrpc-tcp"},
        "allocation": {"enum": ["reserved-random-loopback", "explicit-free-loopback"]},
        "connection_model": {"const": "one-active-client-sequential-reaccept"},
        "identity_binding": {"const": "managed-launch-custody; no-upstream-identity-challenge"},
        "route": {"enum": ["direct-loopback", "wsl-windows-stdio-bridge"]},
        "upstream": {
          "type": "object",
          "additionalProperties": false,
          "required": ["host", "port"],
          "properties": {
            "host": {"const": "127.0.0.1"},
            "port": {"type": "integer", "minimum": 1, "maximum": 65535}
          }
        }
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "port", "attempts", "latency_ms", "canary_state", "capabilities", "transcript_sha256", "failure"],
      "properties": {
        "state": {"enum": ["confirmed", "blocked"]},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "attempts": {"type": "integer", "minimum": 1},
        "latency_ms": {"type": "integer", "minimum": 0},
        "canary_state": {"type": ["string", "null"]},
        "capabilities": {"type": ["object", "null"]},
        "transcript_sha256": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "failure": {"type": ["object", "null"]}
      }
    },
    "overlay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path", "original", "applied", "restore"],
      "properties": {
        "role": {"enum": ["launcher-jvm", "language-server-port"]},
        "path": {"$ref": "#/$defs/nonempty"},
        "original": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sha256", "size", "backup_path"],
          "properties": {"sha256": {"$ref": "#/$defs/digest"}, "size": {"type": "integer", "minimum": 0}, "backup_path": {"$ref": "#/$defs/nonempty"}}
        },
        "applied": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sha256", "size"],
          "properties": {"sha256": {"$ref": "#/$defs/digest"}, "size": {"type": "integer", "minimum": 0}}
        },
        "restore": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "sha256", "preserved_external_changes"],
          "properties": {"state": {"enum": ["restored-exact", "restored-merged", "conflict", "not-applied"]}, "sha256": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]}, "preserved_external_changes": {"type": "boolean"}}
        }
      }
    },
    "limitations": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 8192}}
  }
}
