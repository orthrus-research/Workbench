{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workbench://schemas/crucible/crucible-graph-revision-v2.schema.json",
  "title": "Workbench Crucible graph revision V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "format",
    "schema_version",
    "schema_id",
    "canonicalizer",
    "id",
    "graph_family_id",
    "category_id",
    "resolution_id",
    "purpose_id",
    "authority_owner",
    "recipe_owner",
    "materializer",
    "custodian",
    "recipe_id",
    "recipe_implementation_id",
    "parameter_values_object_descriptor_id",
    "ontology_ids",
    "record_schema_object_descriptor_ids",
    "profile_support_bindings",
    "tool_ids",
    "evidence_set_revision_ids",
    "input_graph_bindings",
    "context_ref_id",
    "parent_graph_revision_ids",
    "partition_policy_id",
    "total_order_policy_id",
    "dependency_manifest_id",
    "partitions",
    "record_counts",
    "record_roots",
    "aggregate_semantic_root",
    "evidence_state",
    "coverage",
    "completeness",
    "support_state",
    "limitations",
    "frontier_record_ids",
    "conflict_record_ids",
    "semantic_validation_requirement_ids"
  ],
  "properties": {
    "kind": {"const": "graph-revision"},
    "format": {"const": "workbench-crucible-graph-revision-v2"},
    "schema_version": {"const": 2},
    "schema_id": {"const": "workbench://schemas/crucible/crucible-graph-revision-v2.schema.json"},
    "canonicalizer": {"const": "workbench-canonical-json-v2"},
    "id": {
      "type": "string",
      "pattern": "^graph-revision:sha256:[0-9a-f]{64}$"
    },
    "graph_family_id": {"$ref": "workbench://schemas/crucible/crucible-v2-common.schema.json#/$defs/semanticIdentifier"},
    "category_id": {"$ref": "workbench://schemas/crucible/crucible-v2-common.schema.json#/$defs/semanticIdentifier"},
    "resolution_id": {"$ref": "workbench://schemas/crucible/crucible-v2-common.schema.json#/$defs/semanticIdentifier"},
    "purpose_id": {"$ref": "workbench://schemas/crucible/crucible-v2-common.schema.json#/$defs/semanticIdentifier"},
    "authority_owner": {"$ref": "workbench://schemas/crucible/crucible-v2-common.schema.json#/$defs/authorityBinding"},
    "recipe_owner": {"$ref": "workbench://schemas/crucible/crucible-v2-common.schema.json#/$defs/authorityBinding"},
    "materializer": {"$ref": "workbench://schemas/crucible/crucible-v2-common.schema.json#/$defs/componentBinding"},
    "custodian": {"$ref": "workbench://schemas/crucible/crucible-v2-common.schema.json#/$defs/componentBinding"},
    "recipe_id": {"$ref": "workbench://schemas/crucible/crucible-v2-common.schema.json#/$defs/materializationRecipeId"},
    "recipe_implementation_id": {"$ref": "workbench://schemas/crucible/crucible-v2-common.schema.json#/$defs/implementationId"},
    "parameter_values_object_descriptor_id": {"$ref": "workbench://schemas/crucible/crucible-v2-common.schema.json#/$defs/objectDescriptorId"},
    "ontology_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "workbench://schemas/crucible/crucible-v2-common.schema.json#/$defs/ontologyId"}
    },
    "record_schema_object_descriptor_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "workbench://schemas/crucible/crucible-v2-common.schema.json#/$defs/objectDescriptorId"}
    },
    "profile_support_bindings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "workbench://schemas/crucible/crucible-v2-common.schema.json#/$defs/profileSupportBinding"}
    },
    "tool_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "workbench://schemas/crucible/crucible-v2-common.schema.json#/$defs/toolId"}
    },
    "evidence_set_revision_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "workbench://schemas/crucible/crucible-v2-common.schema.json#/$defs/evidenceSetRevisionId"}
    },
    "input_graph_bindings": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "workbench://schemas/crucible/crucible-v2-common.schema.json#/$defs/graphInputBinding"}
    },
    "context_ref_id": {"$ref": "workbench://schemas/crucible/crucible-v2-common.schema.json#/$defs/contextRefId"},
    "parent_graph_revision_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "workbench://schemas/crucible/crucible-v2-common.schema.json#/$defs/graphRevisionId"}
    },
    "partition_policy_id": {"$ref": "workbench://schemas/crucible/crucible-v2-common.schema.json#/$defs/policyId"},
    "total_order_policy_id": {"$ref": "workbench://schemas/crucible/crucible-v2-common.schema.json#/$defs/policyId"},
    "dependency_manifest_id": {"$ref": "workbench://schemas/crucible/crucible-v2-common.schema.json#/$defs/dependencyManifestId"},
    "partitions": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "workbench://schemas/crucible/crucible-v2-common.schema.json#/$defs/graphPartition"}
    },
    "record_counts": {"$ref": "workbench://schemas/crucible/crucible-v2-common.schema.json#/$defs/recordCounts"},
    "record_roots": {"$ref": "workbench://schemas/crucible/crucible-v2-common.schema.json#/$defs/recordRoots"},
    "aggregate_semantic_root": {"$ref": "workbench://schemas/crucible/crucible-v2-common.schema.json#/$defs/sha256"},
    "evidence_state": {"$ref": "workbench://schemas/crucible/crucible-v2-common.schema.json#/$defs/evidenceState"},
    "coverage": {"$ref": "workbench://schemas/crucible/crucible-v2-common.schema.json#/$defs/coverage"},
    "completeness": {"$ref": "workbench://schemas/crucible/crucible-v2-common.schema.json#/$defs/completenessState"},
    "support_state": {"$ref": "workbench://schemas/crucible/crucible-v2-common.schema.json#/$defs/supportState"},
    "limitations": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "workbench://schemas/crucible/crucible-v2-common.schema.json#/$defs/limitation"}
    },
    "frontier_record_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "workbench://schemas/crucible/crucible-v2-common.schema.json#/$defs/graphRecordId"}
    },
    "conflict_record_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "workbench://schemas/crucible/crucible-v2-common.schema.json#/$defs/graphRecordId"}
    },
    "semantic_validation_requirement_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "workbench://schemas/crucible/crucible-v2-common.schema.json#/$defs/validationRequirementId"}
    }
  },
  "anyOf": [
    {"properties": {"evidence_set_revision_ids": {"minItems": 1}}},
    {"properties": {"input_graph_bindings": {"minItems": 1}}}
  ]
}
