{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workbench.invalid/schemas/mixin-final-class-definition-receipt-v1.schema.json",
  "title": "Crucible Mixin Final Class Definition Receipt V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schema_version",
    "canonicalization_id",
    "receipt_id",
    "session",
    "inputs",
    "artifacts",
    "observation",
    "foundation",
    "definitions",
    "failures",
    "health",
    "summary",
    "limitations",
    "boundaries"
  ],
  "properties": {
    "format": {"const": "workbench-crucible-mixin-final-class-definition-receipt-v1"},
    "schema_version": {"const": 1},
    "canonicalization_id": {"const": "workbench-canonical-json-v1"},
    "receipt_id": {
      "type": "string",
      "pattern": "^crucible-mixin-final-class-definition:sha256:[0-9a-f]{64}$"
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capture_id", "launch_id", "profile_id", "side", "candidate_lock_sha256", "toolchain_lock_sha256"],
      "properties": {
        "capture_id": {"$ref": "#/$defs/text"},
        "launch_id": {"$ref": "#/$defs/text"},
        "profile_id": {"$ref": "#/$defs/text"},
        "side": {"enum": ["client", "dedicated_server", "integrated_server"]},
        "candidate_lock_sha256": {"$ref": "#/$defs/sha256"},
        "toolchain_lock_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_artifact", "candidate_lock", "fixture_result", "launch_log", "raw_trace", "toolchain_lock"],
      "properties": {
        "agent_artifact": {"$ref": "#/$defs/file"},
        "candidate_lock": {"$ref": "#/$defs/file"},
        "fixture_result": {"$ref": "#/$defs/file"},
        "launch_log": {"$ref": "#/$defs/file"},
        "raw_trace": {"$ref": "#/$defs/file"},
        "toolchain_lock": {"$ref": "#/$defs/file"}
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mechanism", "agent_id", "java_version", "target_class", "expected_input_sha256", "observed_input_sha256", "instrumented_output_sha256", "defining_loader_class", "target_artifact_sha256"],
      "properties": {
        "mechanism": {"const": "exact_foundation_findclass_return_plus_dump_bytes"},
        "agent_id": {"$ref": "#/$defs/text"},
        "java_version": {"$ref": "#/$defs/text"},
        "target_class": {"$ref": "#/$defs/text"},
        "expected_input_sha256": {"$ref": "#/$defs/sha256"},
        "observed_input_sha256": {"$ref": "#/$defs/sha256"},
        "instrumented_output_sha256": {"$ref": "#/$defs/sha256"},
        "defining_loader_class": {"$ref": "#/$defs/text"},
        "target_artifact_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "foundation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "manifest_sha256", "class_count", "total_size_bytes", "foundation_artifact_sha256"],
      "properties": {
        "format": {"const": "workbench-foundation-class-dump-manifest-v1"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "class_count": {"type": "integer", "minimum": 1},
        "total_size_bytes": {"type": "integer", "minimum": 1},
        "foundation_artifact_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "definitions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/definition"}
    },
    "failures": {
      "type": "array",
      "items": {"$ref": "#/$defs/failure"}
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "start_health", "end_health", "write_failure"],
      "properties": {
        "state": {"enum": ["complete", "failed"]},
        "start_health": {"const": "starting"},
        "end_health": {"enum": ["healthy", "failed"]},
        "write_failure": {"type": "boolean"}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested_target_count", "defined_target_count", "cached_return_target_count", "definition_failure_count", "failure_count", "final_bytecode_total_size"],
      "properties": {
        "requested_target_count": {"type": "integer", "minimum": 0},
        "defined_target_count": {"type": "integer", "minimum": 0},
        "cached_return_target_count": {"type": "integer", "minimum": 0},
        "definition_failure_count": {"type": "integer", "minimum": 0},
        "failure_count": {"type": "integer", "minimum": 0},
        "final_bytecode_total_size": {"type": "integer", "minimum": 0}
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/text"}
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["successful_foundation_definition_proved", "final_class_bytes_proved", "application_behavior_proved"],
      "properties": {
        "successful_foundation_definition_proved": {"type": "boolean"},
        "final_class_bytes_proved": {"type": "boolean"},
        "application_behavior_proved": {"const": false}
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "pattern": "^[^\\r\\n\\u0000]+$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableText": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/text"}]},
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "sha256", "size_bytes"],
      "properties": {
        "label": {"$ref": "#/$defs/text"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_sha256", "size_bytes", "label", "code_source_uri"],
      "properties": {
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "label": {"$ref": "#/$defs/text"},
        "code_source_uri": {"$ref": "#/$defs/text"}
      }
    },
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "target_class", "defined_class", "class_identity", "defining_loader_class", "defining_loader_identity", "target_artifact_sha256", "dump_relative_path", "final_bytecode_sha256", "final_bytecode_size"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 0},
        "target_class": {"$ref": "#/$defs/text"},
        "defined_class": {"$ref": "#/$defs/text"},
        "class_identity": {"$ref": "#/$defs/text"},
        "defining_loader_class": {"$ref": "#/$defs/text"},
        "defining_loader_identity": {"$ref": "#/$defs/text"},
        "target_artifact_sha256": {"$ref": "#/$defs/sha256"},
        "dump_relative_path": {"$ref": "#/$defs/text"},
        "final_bytecode_sha256": {"$ref": "#/$defs/sha256"},
        "final_bytecode_size": {"type": "integer", "minimum": 1}
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "event", "target_class", "reason_code", "exception_class"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 0},
        "event": {"enum": ["transform_rejected", "transform_failure", "definition_failure", "observer_failure"]},
        "target_class": {"$ref": "#/$defs/nullableText"},
        "reason_code": {"$ref": "#/$defs/text"},
        "exception_class": {"$ref": "#/$defs/nullableText"}
      }
    }
  }
}
