{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workbench.invalid/schemas/gtceu-worldgen-inventory-v1.schema.json",
  "title": "Workbench Crucible GTCEu worldgen inventory v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schema_version",
    "inventory_id",
    "canonicalization_id",
    "adapter_profile",
    "artifact",
    "configuration",
    "definitions",
    "summary",
    "observation",
    "boundaries"
  ],
  "properties": {
    "format": {"const": "workbench-crucible-gtceu-worldgen-inventory-v1"},
    "schema_version": {"const": 1},
    "inventory_id": {
      "type": "string",
      "pattern": "^crucible-gtceu-worldgen:sha256:[0-9a-f]{64}$"
    },
    "canonicalization_id": {"const": "workbench-canonical-json-v1"},
    "adapter_profile": {
      "type": "object",
      "required": ["id", "grid_size_chunks", "public_seams"]
    },
    "artifact": {
      "allOf": [
        {"$ref": "#/$defs/binding"},
        {
          "type": "object",
          "required": ["mod_id", "mod_version", "minecraft_version", "required_api_classes"],
          "properties": {
            "mod_id": {"const": "gregtech"},
            "mod_version": {"const": "2.8.10-beta"},
            "minecraft_version": {"const": "1.12.2"},
            "required_api_classes": {
              "type": "array",
              "minItems": 6,
              "items": {"$ref": "#/$defs/apiClass"}
            }
          }
        }
      ]
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tree_sha256", "file_count", "files"],
      "properties": {
        "tree_sha256": {"$ref": "#/$defs/sha256"},
        "file_count": {"type": "integer", "minimum": 1},
        "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/binding"}}
      }
    },
    "definitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "relative_path",
          "weight",
          "enabled_by_base_weight",
          "dimension_ids",
          "has_dimension_filter",
          "has_biome_modifier",
          "material_tokens",
          "source_sha256",
          "source_size_bytes"
        ],
        "properties": {
          "kind": {"enum": ["ore", "fluid"]},
          "relative_path": {"type": "string", "pattern": "^worldgen/(vein|fluid)/.+\\.json$"},
          "weight": {"type": "integer"},
          "enabled_by_base_weight": {"type": "boolean"},
          "dimension_ids": {"type": "array", "items": {"type": "integer"}, "uniqueItems": true},
          "has_dimension_filter": {"type": "boolean"},
          "has_biome_modifier": {"type": "boolean"},
          "material_tokens": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "source_sha256": {"$ref": "#/$defs/sha256"},
          "source_size_bytes": {"type": "integer", "minimum": 1}
        }
      }
    },
    "summary": {"type": "object", "required": ["definition_count", "ore_definition_count", "fluid_definition_count"]},
    "observation": {"type": ["object", "null"]},
    "boundaries": {
      "const": {
        "configuration_was_modified": false,
        "definitions_are_exactly_bound": true,
        "gregtech_version_specific": true,
        "observed_state_proves_deposit_cause": false,
        "recurrent_complex_integration_added": false,
        "strata_geometry_is_authority": false
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "binding": {
      "type": "object",
      "required": ["relative_path", "sha256", "size_bytes"],
      "properties": {
        "relative_path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "apiClass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry", "sha256", "size_bytes"],
      "properties": {
        "entry": {"type": "string", "pattern": "\\.class$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1}
      }
    }
  }
}
