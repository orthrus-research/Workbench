{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workbench.invalid/schemas/gtceu-worldgen-overlay-materialization-v1.schema.json",
  "title": "Workbench Crucible GTCEu worldgen overlay materialization v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schema_version",
    "materialization_id",
    "source_inventory_id",
    "output_inventory_id",
    "operation_count",
    "operations",
    "output_inventory",
    "boundaries"
  ],
  "properties": {
    "format": {"const": "workbench-crucible-gtceu-worldgen-overlay-materialization-v1"},
    "schema_version": {"const": 1},
    "materialization_id": {
      "type": "string",
      "pattern": "^crucible-gtceu-overlay:sha256:[0-9a-f]{64}$"
    },
    "source_inventory_id": {"$ref": "#/$defs/inventoryId"},
    "output_inventory_id": {"$ref": "#/$defs/inventoryId"},
    "operation_count": {"type": "integer", "minimum": 1},
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["op", "kind", "relative_path"],
        "properties": {
          "op": {"enum": ["add", "replace", "remove"]},
          "kind": {"enum": ["ore", "fluid"]},
          "relative_path": {
            "type": "string",
            "pattern": "^worldgen/(vein|fluid)/.+\\.json$"
          }
        }
      }
    },
    "output_inventory": {"const": "gtceu-worldgen-inventory-v1.json"},
    "boundaries": {
      "const": {
        "source_configuration_modified": false,
        "output_is_disposable_materialization": true,
        "runtime_reload_or_restart_performed": false,
        "recurrent_complex_integration_added": false
      }
    }
  },
  "$defs": {
    "inventoryId": {
      "type": "string",
      "pattern": "^crucible-gtceu-worldgen:sha256:[0-9a-f]{64}$"
    }
  }
}
