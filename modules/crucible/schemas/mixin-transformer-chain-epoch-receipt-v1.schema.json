{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workbench.local/schemas/mixin-transformer-chain-epoch-receipt-v1.schema.json",
  "title": "Crucible Mixin transformer-chain epoch receipt V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format", "schema_version", "canonicalization_id", "receipt_id", "session",
    "inputs", "artifacts", "observation", "refreshes", "epochs", "failures",
    "health", "summary", "limitations", "boundaries"
  ],
  "properties": {
    "format": {"const": "workbench-crucible-mixin-transformer-chain-epoch-receipt-v1"},
    "schema_version": {"const": 1},
    "canonicalization_id": {"const": "workbench-canonical-json-v1"},
    "receipt_id": {
      "type": "string",
      "pattern": "^crucible-mixin-transformer-chain-epoch:sha256:[0-9a-f]{64}$"
    },
    "session": {"$ref": "#/$defs/session"},
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_artifact", "candidate_lock", "fixture_result", "launch_log", "raw_trace", "toolchain_lock"],
      "properties": {
        "agent_artifact": {"$ref": "#/$defs/file"},
        "candidate_lock": {"$ref": "#/$defs/file"},
        "fixture_result": {"$ref": "#/$defs/file"},
        "launch_log": {"$ref": "#/$defs/file"},
        "raw_trace": {"$ref": "#/$defs/file"},
        "toolchain_lock": {"$ref": "#/$defs/file"}
      }
    },
    "artifacts": {
      "type": "array",
      "items": {"$ref": "#/$defs/artifact"}
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mechanism", "agent_id", "java_version", "targets"],
      "properties": {
        "mechanism": {"const": "java_instrument_exact_cleanroom_transformer_provider"},
        "agent_id": {"$ref": "#/$defs/text"},
        "java_version": {"$ref": "#/$defs/text"},
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["target_class", "expected_input_sha256", "observed_input_sha256", "instrumented_output_sha256", "defining_loader_class", "target_artifact_sha256"],
            "properties": {
              "target_class": {"$ref": "#/$defs/text"},
              "expected_input_sha256": {"$ref": "#/$defs/sha256"},
              "observed_input_sha256": {"$ref": "#/$defs/sha256"},
              "instrumented_output_sha256": {"$ref": "#/$defs/sha256"},
              "defining_loader_class": {"$ref": "#/$defs/text"},
              "target_artifact_sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        }
      }
    },
    "refreshes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sequence", "refresh_id", "reason_code", "phase", "delegated_cache_present", "previous_transformer_count", "live_transformer_count", "supersedes_refresh_id", "outcome", "epoch"],
        "properties": {
          "sequence": {"type": "integer", "minimum": 0},
          "refresh_id": {"type": "integer", "minimum": 1},
          "reason_code": {"$ref": "#/$defs/text"},
          "phase": {"$ref": "#/$defs/text"},
          "delegated_cache_present": {"type": "boolean"},
          "previous_transformer_count": {"type": "integer", "minimum": -1},
          "live_transformer_count": {"type": "integer", "minimum": 0},
          "supersedes_refresh_id": {"type": ["integer", "null"], "minimum": 1},
          "outcome": {"enum": ["rebuilt", "superseded", "invalidated_at_shutdown"]},
          "epoch": {"type": ["integer", "null"], "minimum": 1}
        }
      }
    },
    "epochs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["epoch", "sequence", "refresh_id", "refresh_reason", "phase", "provider_class", "provider_loader_class", "provider_artifact_sha256", "foundation_artifact_sha256", "previous_transformer_count", "live_chain", "delegated_chain", "provider_exclusions", "foundation_transformer_exclusions"],
        "properties": {
          "epoch": {"type": "integer", "minimum": 1},
          "sequence": {"type": "integer", "minimum": 0},
          "refresh_id": {"type": "integer", "minimum": 1},
          "refresh_reason": {"$ref": "#/$defs/text"},
          "phase": {"$ref": "#/$defs/text"},
          "provider_class": {"$ref": "#/$defs/text"},
          "provider_loader_class": {"$ref": "#/$defs/text"},
          "provider_artifact_sha256": {"$ref": "#/$defs/sha256"},
          "foundation_artifact_sha256": {"$ref": "#/$defs/sha256"},
          "previous_transformer_count": {"type": "integer", "minimum": -1},
          "live_chain": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/chain_entry"}},
          "delegated_chain": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/chain_entry"}},
          "provider_exclusions": {"$ref": "#/$defs/text_array"},
          "foundation_transformer_exclusions": {"$ref": "#/$defs/text_array"}
        }
      }
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sequence", "event", "reason_code", "exception_class"],
        "properties": {
          "sequence": {"type": "integer", "minimum": 0},
          "event": {"enum": ["transform_rejected", "transform_failure", "observer_failure"]},
          "reason_code": {"$ref": "#/$defs/text"},
          "exception_class": {"anyOf": [{"$ref": "#/$defs/text"}, {"type": "null"}]}
        }
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "start_health", "end_health", "write_failure"],
      "properties": {
        "state": {"enum": ["complete", "failed"]},
        "start_health": {"const": "starting"},
        "end_health": {"enum": ["healthy", "failed"]},
        "write_failure": {"type": "boolean"}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["epoch_count", "refresh_count", "rebuilt_refresh_count", "superseded_refresh_count", "unresolved_refresh_count", "exclusion_change_count", "max_live_transformer_count", "max_delegated_transformer_count", "failure_count"],
      "properties": {
        "epoch_count": {"type": "integer", "minimum": 0},
        "refresh_count": {"type": "integer", "minimum": 0},
        "rebuilt_refresh_count": {"type": "integer", "minimum": 0},
        "superseded_refresh_count": {"type": "integer", "minimum": 0},
        "unresolved_refresh_count": {"type": "integer", "minimum": 0},
        "exclusion_change_count": {"type": "integer", "minimum": 0},
        "max_live_transformer_count": {"type": "integer", "minimum": 0},
        "max_delegated_transformer_count": {"type": "integer", "minimum": 0},
        "failure_count": {"type": "integer", "minimum": 0}
      }
    },
    "limitations": {"$ref": "#/$defs/text_array"},
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transformer_chain_epochs_proved", "provider_exclusions_proved", "foundation_transformer_exclusions_proved", "transformer_execution_completion_proved", "final_class_bytes_proved"],
      "properties": {
        "transformer_chain_epochs_proved": {"type": "boolean"},
        "provider_exclusions_proved": {"type": "boolean"},
        "foundation_transformer_exclusions_proved": {"type": "boolean"},
        "transformer_execution_completion_proved": {"const": false},
        "final_class_bytes_proved": {"const": false}
      }
    }
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 8192, "pattern": "^[^\\r\\n\\u0000]+$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "text_array": {"type": "array", "items": {"$ref": "#/$defs/text"}, "uniqueItems": true},
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "sha256", "size_bytes"],
      "properties": {
        "label": {"$ref": "#/$defs/text"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capture_id", "launch_id", "profile_id", "side", "candidate_lock_sha256", "toolchain_lock_sha256"],
      "properties": {
        "capture_id": {"$ref": "#/$defs/text"},
        "launch_id": {"$ref": "#/$defs/text"},
        "profile_id": {"$ref": "#/$defs/text"},
        "side": {"enum": ["client", "dedicated_server", "integrated_server"]},
        "candidate_lock_sha256": {"$ref": "#/$defs/sha256"},
        "toolchain_lock_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_sha256", "size_bytes", "label", "code_source_uri"],
      "properties": {
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "label": {"$ref": "#/$defs/text"},
        "code_source_uri": {"$ref": "#/$defs/text"}
      }
    },
    "chain_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "reported_name", "implementation_class", "wrapper_class", "implementation_loader_class", "artifact_sha256", "priority", "delegation_excluded"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 0},
        "reported_name": {"$ref": "#/$defs/text"},
        "implementation_class": {"$ref": "#/$defs/text"},
        "wrapper_class": {"anyOf": [{"$ref": "#/$defs/text"}, {"type": "null"}]},
        "implementation_loader_class": {"$ref": "#/$defs/text"},
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "priority": {"type": ["integer", "null"], "minimum": -2147483648, "maximum": 2147483647},
        "delegation_excluded": {"type": ["boolean", "null"]}
      }
    }
  }
}
