{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workbench://schemas/crucible/crucible-dependency-manifest-v2.schema.json",
  "title": "Workbench Crucible materialization dependency manifest V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "format",
    "schema_version",
    "schema_id",
    "canonicalizer",
    "id",
    "authority_owner",
    "recipe_owner",
    "recipe_id",
    "recipe_implementation_id",
    "context_ref_id",
    "evidence_set_revision_ids",
    "input_graph_bindings",
    "parameter_values_object_descriptor_id",
    "input_components",
    "parent_dependency_manifest_id",
    "dependency_state",
    "invalidation_policy_id",
    "footprints",
    "semantic_root"
  ],
  "properties": {
    "kind": {"const": "dependency-manifest"},
    "format": {"const": "workbench-crucible-dependency-manifest-v2"},
    "schema_version": {"const": 2},
    "schema_id": {"const": "workbench://schemas/crucible/crucible-dependency-manifest-v2.schema.json"},
    "canonicalizer": {"const": "workbench-canonical-json-v2"},
    "id": {
      "type": "string",
      "pattern": "^dependency-manifest:sha256:[0-9a-f]{64}$"
    },
    "authority_owner": {"$ref": "workbench://schemas/crucible/crucible-v2-common.schema.json#/$defs/authorityBinding"},
    "recipe_owner": {"$ref": "workbench://schemas/crucible/crucible-v2-common.schema.json#/$defs/authorityBinding"},
    "recipe_id": {"$ref": "workbench://schemas/crucible/crucible-v2-common.schema.json#/$defs/materializationRecipeId"},
    "recipe_implementation_id": {"$ref": "workbench://schemas/crucible/crucible-v2-common.schema.json#/$defs/implementationId"},
    "context_ref_id": {"$ref": "workbench://schemas/crucible/crucible-v2-common.schema.json#/$defs/contextRefId"},
    "evidence_set_revision_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "workbench://schemas/crucible/crucible-v2-common.schema.json#/$defs/evidenceSetRevisionId"}
    },
    "input_graph_bindings": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "workbench://schemas/crucible/crucible-v2-common.schema.json#/$defs/graphInputBinding"}
    },
    "parameter_values_object_descriptor_id": {"$ref": "workbench://schemas/crucible/crucible-v2-common.schema.json#/$defs/objectDescriptorId"},
    "input_components": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "workbench://schemas/crucible/crucible-v2-common.schema.json#/$defs/dependencyComponentBinding"}
    },
    "parent_dependency_manifest_id": {"$ref": "workbench://schemas/crucible/crucible-v2-common.schema.json#/$defs/nullableDependencyManifestId"},
    "dependency_state": {"enum": ["exact", "conservative-broad"]},
    "invalidation_policy_id": {"$ref": "workbench://schemas/crucible/crucible-v2-common.schema.json#/$defs/policyId"},
    "footprints": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "output_partitions",
          "evidence_record_ids",
          "admission_record_ids",
          "admission_partitions",
          "evidence_partitions",
          "source_graph_records",
          "source_graph_partitions",
          "component_keys",
          "footprint_root"
        ],
        "properties": {
          "output_partitions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"$ref": "workbench://schemas/crucible/crucible-v2-common.schema.json#/$defs/outputGraphPartition"}
          },
          "evidence_record_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"$ref": "workbench://schemas/crucible/crucible-v2-common.schema.json#/$defs/evidenceRecordId"}
          },
          "admission_record_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"$ref": "workbench://schemas/crucible/crucible-v2-common.schema.json#/$defs/admissionRecordId"}
          },
          "admission_partitions": {
            "type": "array",
            "uniqueItems": true,
            "items": {"$ref": "workbench://schemas/crucible/crucible-v2-common.schema.json#/$defs/sourceAdmissionPartition"}
          },
          "evidence_partitions": {
            "type": "array",
            "uniqueItems": true,
            "items": {"$ref": "workbench://schemas/crucible/crucible-v2-common.schema.json#/$defs/sourceEvidencePartition"}
          },
          "source_graph_records": {
            "type": "array",
            "uniqueItems": true,
            "items": {"$ref": "workbench://schemas/crucible/crucible-v2-common.schema.json#/$defs/sourceGraphRecord"}
          },
          "source_graph_partitions": {
            "type": "array",
            "uniqueItems": true,
            "items": {"$ref": "workbench://schemas/crucible/crucible-v2-common.schema.json#/$defs/sourceGraphPartition"}
          },
          "component_keys": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"$ref": "workbench://schemas/crucible/crucible-v2-common.schema.json#/$defs/semanticIdentifier"}
          },
          "footprint_root": {"$ref": "workbench://schemas/crucible/crucible-v2-common.schema.json#/$defs/sha256"}
        }
      }
    },
    "semantic_root": {"$ref": "workbench://schemas/crucible/crucible-v2-common.schema.json#/$defs/sha256"}
  },
  "anyOf": [
    {"properties": {"evidence_set_revision_ids": {"minItems": 1}}},
    {"properties": {"input_graph_bindings": {"minItems": 1}}}
  ]
}
