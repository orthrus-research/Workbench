{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workbench.invalid/schemas/runtime-snapshot-v2.schema.json",
  "title": "Workbench Crucible Composite Runtime Snapshot V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schema_version",
    "canonicalization_id",
    "snapshot_id",
    "authority",
    "runtime_identity",
    "epoch",
    "receipt_bindings",
    "capabilities",
    "capture_health",
    "summary",
    "limitations"
  ],
  "properties": {
    "format": {"const": "workbench-crucible-runtime-snapshot-v2"},
    "schema_version": {"const": 2},
    "canonicalization_id": {"const": "workbench-canonical-json-v1"},
    "snapshot_id": {
      "type": "string",
      "pattern": "^crucible-runtime-snapshot:sha256:[0-9a-f]{64}$"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "claim", "interpretation_authority", "construction_authority"],
      "properties": {
        "owner": {"const": "Crucible"},
        "claim": {"const": "validated-receipt-composition"},
        "interpretation_authority": {"const": "Atlas"},
        "construction_authority": {"const": "Blueprints"}
      }
    },
    "runtime_identity": {"$ref": "#/$defs/runtimeIdentity"},
    "epoch": {"$ref": "#/$defs/epoch"},
    "receipt_bindings": {
      "type": "array",
      "items": {"$ref": "#/$defs/receiptBinding"}
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/capability"}
    },
    "capture_health": {"$ref": "#/$defs/captureHealth"},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt_count", "capability_count", "capability_states", "evidence_backed_capabilities"],
      "properties": {
        "receipt_count": {"type": "integer", "minimum": 0},
        "capability_count": {"type": "integer", "minimum": 1},
        "evidence_backed_capabilities": {"type": "integer", "minimum": 0},
        "capability_states": {
          "type": "object",
          "additionalProperties": false,
          "required": ["failed", "not_observed", "observed", "partial", "unavailable"],
          "properties": {
            "failed": {"type": "integer", "minimum": 0},
            "not_observed": {"type": "integer", "minimum": 0},
            "observed": {"type": "integer", "minimum": 0},
            "partial": {"type": "integer", "minimum": 0},
            "unavailable": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/text"}
    }
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 8192, "pattern": "^[^\\r\\n\\u0000]+$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "capabilityName": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "runtimeIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "launch_id",
        "platform_profile_id",
        "pack_profile_id",
        "physical_side",
        "process_outcome",
        "candidate_lock_sha256",
        "transformer_toolchain_lock_sha256",
        "java_runtime_id",
        "session_ids",
        "capture_ids"
      ],
      "properties": {
        "launch_id": {"$ref": "#/$defs/text"},
        "platform_profile_id": {"$ref": "#/$defs/text"},
        "pack_profile_id": {"oneOf": [{"$ref": "#/$defs/text"}, {"type": "null"}]},
        "physical_side": {"enum": ["client", "dedicated_server", "integrated_server"]},
        "process_outcome": {"enum": ["running", "complete", "crashed", "failed", "incomplete"]},
        "candidate_lock_sha256": {"$ref": "#/$defs/sha256"},
        "transformer_toolchain_lock_sha256": {"$ref": "#/$defs/sha256"},
        "java_runtime_id": {"$ref": "#/$defs/text"},
        "session_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
        "capture_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}
      }
    },
    "axis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": {"$ref": "#/$defs/capabilityName"},
        "value": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\r\\n\\u0000]+$"}
      }
    },
    "epoch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_epoch_id", "adapter_id", "adapter_version", "axes", "capabilities"],
      "properties": {
        "profile_epoch_id": {"$ref": "#/$defs/text"},
        "adapter_id": {"$ref": "#/$defs/text"},
        "adapter_version": {"type": "string", "minLength": 1, "maxLength": 128},
        "axes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/axis"}},
        "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/capabilityName"}}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["launch_id", "profile_id", "physical_side", "session_id", "capture_id"],
      "properties": {
        "launch_id": {"$ref": "#/$defs/text"},
        "profile_id": {"$ref": "#/$defs/text"},
        "physical_side": {"enum": ["client", "dedicated_server", "integrated_server"]},
        "session_id": {"oneOf": [{"$ref": "#/$defs/text"}, {"type": "null"}]},
        "capture_id": {"oneOf": [{"$ref": "#/$defs/text"}, {"type": "null"}]}
      }
    },
    "lockBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "sha256"],
      "properties": {
        "kind": {"type": "string", "minLength": 1, "maxLength": 128},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "receiptBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "format",
        "receipt_id",
        "source_label",
        "source_sha256",
        "semantic_fingerprint",
        "validator",
        "scope",
        "lock_bindings",
        "limitations"
      ],
      "properties": {
        "role": {"$ref": "#/$defs/capabilityName"},
        "format": {"type": "string", "minLength": 1, "maxLength": 256},
        "receipt_id": {"$ref": "#/$defs/text"},
        "source_label": {"type": "string", "minLength": 1, "maxLength": 1024},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "semantic_fingerprint": {"$ref": "#/$defs/sha256"},
        "validator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "adapter"],
          "properties": {
            "state": {"const": "passed"},
            "adapter": {"$ref": "#/$defs/text"}
          }
        },
        "scope": {"$ref": "#/$defs/scope"},
        "lock_bindings": {"type": "array", "items": {"$ref": "#/$defs/lockBinding"}},
        "limitations": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "state", "receipt_ids", "semantic_fingerprint", "reason_code", "limitations"],
      "properties": {
        "name": {"$ref": "#/$defs/capabilityName"},
        "state": {"enum": ["observed", "partial", "not_observed", "unavailable", "failed"]},
        "receipt_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
        "semantic_fingerprint": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "reason_code": {"oneOf": [{"type": "string", "minLength": 1, "maxLength": 128}, {"type": "null"}]},
        "limitations": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}
      }
    },
    "captureError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability", "code", "message", "receipt_id"],
      "properties": {
        "capability": {"$ref": "#/$defs/capabilityName"},
        "code": {"type": "string", "minLength": 1, "maxLength": 128},
        "message": {"$ref": "#/$defs/text"},
        "receipt_id": {"oneOf": [{"$ref": "#/$defs/text"}, {"type": "null"}]}
      }
    },
    "captureHealth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observer_state", "started", "completed", "errors"],
      "properties": {
        "observer_state": {"enum": ["healthy", "degraded", "failed", "incomplete"]},
        "started": {"const": true},
        "completed": {"type": "boolean"},
        "errors": {"type": "array", "items": {"$ref": "#/$defs/captureError"}}
      }
    }
  }
}
