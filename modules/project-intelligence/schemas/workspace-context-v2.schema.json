{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workbench.invalid/schemas/workspace-context-v2.schema.json",
  "title": "Workbench workspace context V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schema_version",
    "workspace",
    "project",
    "platform",
    "pack"
  ],
  "properties": {
    "format": {
      "const": "workbench-workspace-context-v2"
    },
    "schema_version": {
      "const": 2
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_uri",
        "revision",
        "dirty",
        "dirty_entries"
      ],
      "properties": {
        "root_uri": {
          "type": "string",
          "format": "uri"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$"
        },
        "dirty": {
          "type": "boolean"
        },
        "dirty_entries": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3
          },
          "uniqueItems": true
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name",
        "version",
        "author",
        "pack_format",
        "manifest_sha256",
        "minecraft_version",
        "loaders",
        "index",
        "matched_paths"
      ],
      "properties": {
        "kind": {
          "const": "packwiz-modpack"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "author": {
          "type": "string",
          "minLength": 1
        },
        "pack_format": {
          "type": "string",
          "minLength": 1
        },
        "manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "minecraft_version": {
          "type": "string",
          "minLength": 1
        },
        "loaders": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "version"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "uniqueItems": true
        },
        "index": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file",
            "hash_format",
            "declared_hash",
            "actual_sha256",
            "matches_declared_hash"
          ],
          "properties": {
            "file": {
              "type": "string",
              "minLength": 1
            },
            "hash_format": {
              "const": "sha256"
            },
            "declared_hash": {
              "$ref": "#/$defs/sha256"
            },
            "actual_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "matches_declared_hash": {
              "type": "boolean"
            }
          }
        },
        "matched_paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "status",
        "minecraft_version",
        "cleanroom_version",
        "document_sha256"
      ],
      "properties": {
        "profile_id": {
          "type": "string",
          "pattern": "^workbench-platform:cleanroom:"
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "minecraft_version": {
          "type": "string",
          "minLength": 1
        },
        "cleanroom_version": {
          "type": "string",
          "minLength": 1
        },
        "document_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "pack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_family_id",
        "display_name",
        "status",
        "selected_profile",
        "maturity",
        "platform_profile_id",
        "permitted_operations",
        "document_sha256"
      ],
      "properties": {
        "profile_family_id": {
          "type": "string",
          "pattern": "^workbench-pack:"
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "selected_profile": {
          "type": "string",
          "minLength": 1
        },
        "maturity": {
          "type": "string",
          "minLength": 1
        },
        "platform_profile_id": {
          "type": "string",
          "pattern": "^workbench-platform:cleanroom:"
        },
        "permitted_operations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "document_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
