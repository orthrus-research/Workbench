{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cleanroommc.dev/workbench/schemas/workbench-pr-preparation-receipt-v2.schema.json",
  "title": "Workbench provider-bound pull-request preparation receipt V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schema_version",
    "receipt_id",
    "acquisition_profile_id",
    "acquisition_profile_digest",
    "provider_profile_id",
    "provider_profile_digest",
    "provider_kind",
    "project_id",
    "pull_request",
    "pull_request_url",
    "pull_request_state",
    "pull_request_merged",
    "channel_id",
    "remote_url",
    "repository_root",
    "repository_head_before_prepare",
    "base_repository",
    "base_name",
    "base_remote_ref",
    "base_oid",
    "base_ref",
    "head_repository",
    "head_name",
    "head_remote_ref",
    "head_oid",
    "head_ref",
    "provider_merge_remote_ref",
    "provider_merge_oid",
    "provider_merge_ref",
    "delta_kind",
    "prepared_at"
  ],
  "properties": {
    "format": {"const": "workbench-pr-preparation-receipt-v2"},
    "schema_version": {"const": 2},
    "receipt_id": {"type": "string", "pattern": "^workbench-pr-preparation-v2:sha256:[0-9a-f]{64}$"},
    "acquisition_profile_id": {"type": "string", "minLength": 1},
    "acquisition_profile_digest": {"type": "string", "pattern": "^workbench-project-acquisition-profile:sha256:[0-9a-f]{64}$"},
    "provider_profile_id": {"type": "string", "minLength": 1},
    "provider_profile_digest": {"type": "string", "pattern": "^workbench-pull-request-provider-profile:sha256:[0-9a-f]{64}$"},
    "provider_kind": {"const": "github"},
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "not": {
        "anyOf": [
          {"pattern": "\\.\\."},
          {"pattern": "\\.$"},
          {"pattern": "\\.[Ll][Oo][Cc][Kk]$"},
          {"pattern": "^(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.|$)"}
        ]
      }
    },
    "pull_request": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "pull_request_url": {"type": "string", "format": "uri"},
    "pull_request_state": {"enum": ["open", "closed"]},
    "pull_request_merged": {"type": "boolean"},
    "channel_id": {"type": "string", "minLength": 1},
    "remote_url": {"type": "string", "minLength": 1},
    "repository_root": {"type": "string", "minLength": 1},
    "repository_head_before_prepare": {"$ref": "#/$defs/object_id"},
    "base_repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "base_name": {"type": "string", "minLength": 1},
    "base_remote_ref": {"$ref": "#/$defs/ref"},
    "base_oid": {"$ref": "#/$defs/object_id"},
    "base_ref": {"$ref": "#/$defs/ref"},
    "head_repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "head_name": {"type": "string", "minLength": 1},
    "head_remote_ref": {"$ref": "#/$defs/ref"},
    "head_oid": {"$ref": "#/$defs/object_id"},
    "head_ref": {"$ref": "#/$defs/ref"},
    "provider_merge_remote_ref": {"$ref": "#/$defs/ref"},
    "provider_merge_oid": {"oneOf": [{"$ref": "#/$defs/object_id"}, {"type": "null"}]},
    "provider_merge_ref": {"oneOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]},
    "delta_kind": {"const": "provider-base-to-head"},
    "prepared_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "object_id": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "ref": {"type": "string", "pattern": "^refs/[A-Za-z0-9][A-Za-z0-9._/-]*$"}
  }
}
