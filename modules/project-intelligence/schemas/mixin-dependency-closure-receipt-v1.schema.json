{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workbench.invalid/schemas/mixin-dependency-closure-receipt-v1.schema.json",
  "title": "Workbench Mixin dependency closure receipt V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifacts", "boundaries", "canonicalization_id", "class_headers", "closure", "dependencies", "format", "limitations", "receipt_id", "resolutions", "schema_version", "summary"],
  "properties": {
    "artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}},
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caller_assertion_is_dependency_metadata_proof", "candidate_lock_v1_mutated", "runtime_classloader_order_proved", "static_class_resolution_only"],
      "properties": {
        "caller_assertion_is_dependency_metadata_proof": {"const": false},
        "candidate_lock_v1_mutated": {"const": false},
        "runtime_classloader_order_proved": {"const": false},
        "static_class_resolution_only": {"const": true}
      }
    },
    "canonicalization_id": {"const": "workbench-canonical-json-v1"},
    "class_headers": {"type": "array", "items": {"$ref": "#/$defs/header"}},
    "closure": {"$ref": "#/$defs/closure"},
    "dependencies": {"type": "array", "items": {"$ref": "#/$defs/dependency"}},
    "format": {"const": "workbench-project-intelligence-mixin-dependency-closure-receipt-v1"},
    "limitations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "receipt_id": {"type": "string", "pattern": "^workbench-mixin-dependency-closure-receipt:sha256:[0-9a-f]{64}$"},
    "resolutions": {"type": "array", "items": {"$ref": "#/$defs/resolution"}},
    "schema_version": {"const": 1},
    "summary": {"$ref": "#/$defs/summary"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_id", "class_count", "class_inventory_sha256", "file_name", "role", "sha256", "size_bytes"],
      "properties": {
        "artifact_id": {"type": "string", "pattern": "^workbench-mixin-dependency-artifact:sha256:[0-9a-f]{64}$"},
        "class_count": {"type": "integer", "minimum": 0},
        "class_inventory_sha256": {"$ref": "#/$defs/sha256"},
        "file_name": {"type": "string", "minLength": 1},
        "role": {"enum": ["root", "required-runtime", "optional-runtime", "provided-runtime", "compile-only", "observation-only"]},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "header": {
      "type": "object", "additionalProperties": false,
      "required": ["access_flags", "artifact_sha256", "class_file_major", "class_file_minor", "class_name", "direct_interfaces", "entry_path", "entry_sha256", "header_id", "path_state", "superclass_name"],
      "properties": {
        "access_flags": {"type": "integer", "minimum": 0, "maximum": 65535},
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "class_file_major": {"type": "integer", "minimum": 0, "maximum": 65535},
        "class_file_minor": {"type": "integer", "minimum": 0, "maximum": 65535},
        "class_name": {"type": "string", "minLength": 1},
        "direct_interfaces": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "entry_path": {"type": "string", "minLength": 1},
        "entry_sha256": {"$ref": "#/$defs/sha256"},
        "header_id": {"type": "string", "pattern": "^workbench-jvm-class-header:sha256:[0-9a-f]{64}$"},
        "path_state": {"enum": ["exact", "mismatch"]},
        "superclass_name": {"type": ["string", "null"]}
      }
    },
    "dependency": {
      "type": "object", "additionalProperties": false,
      "required": ["edge_id", "relationship", "source_artifact_sha256", "target_artifact_sha256"],
      "properties": {
        "edge_id": {"type": "string", "pattern": "^workbench-mixin-dependency-edge:sha256:[0-9a-f]{64}$"},
        "relationship": {"enum": ["required-runtime", "optional-runtime", "provided-runtime", "compile-only", "observation-only"]},
        "source_artifact_sha256": {"$ref": "#/$defs/sha256"},
        "target_artifact_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "provider": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_sha256", "header_id", "resolution_path"],
      "properties": {
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "header_id": {"type": "string", "pattern": "^workbench-jvm-class-header:sha256:[0-9a-f]{64}$"},
        "resolution_path": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sha256"}}
      }
    },
    "resolution": {
      "type": "object", "additionalProperties": false,
      "required": ["class_name", "providers", "purpose", "requester_artifact_sha256", "resolution_id", "resolution_state", "selected_header_id", "selected_path"],
      "properties": {
        "class_name": {"type": "string", "minLength": 1},
        "providers": {"type": "array", "items": {"$ref": "#/$defs/provider"}},
        "purpose": {"enum": ["config-plugin", "mixin-connector", "class-resolution"]},
        "requester_artifact_sha256": {"$ref": "#/$defs/sha256"},
        "resolution_id": {"type": "string", "pattern": "^workbench-jvm-class-resolution:sha256:[0-9a-f]{64}$"},
        "resolution_state": {"enum": ["resolved", "missing", "unresolved", "ambiguous"]},
        "selected_header_id": {"type": ["string", "null"], "pattern": "^workbench-jvm-class-header:sha256:[0-9a-f]{64}$"},
        "selected_path": {"oneOf": [{"type": "null"}, {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sha256"}}]}
      }
    },
    "closure": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_set_sha256", "closure_state", "completeness_assertion", "dependency_set_sha256", "request_set_sha256", "root_artifact_sha256s"],
      "properties": {
        "artifact_set_sha256": {"$ref": "#/$defs/sha256"},
        "closure_state": {"enum": ["complete", "incomplete"]},
        "completeness_assertion": {"enum": ["caller-declared-complete", "caller-declared-incomplete"]},
        "dependency_set_sha256": {"$ref": "#/$defs/sha256"},
        "request_set_sha256": {"$ref": "#/$defs/sha256"},
        "root_artifact_sha256s": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}}
      }
    },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["ambiguous_resolution_count", "artifact_count", "class_header_count", "dependency_count", "missing_resolution_count", "request_count", "resolved_count", "unresolved_count"],
      "properties": {
        "ambiguous_resolution_count": {"type": "integer", "minimum": 0},
        "artifact_count": {"type": "integer", "minimum": 1},
        "class_header_count": {"type": "integer", "minimum": 0},
        "dependency_count": {"type": "integer", "minimum": 0},
        "missing_resolution_count": {"type": "integer", "minimum": 0},
        "request_count": {"type": "integer", "minimum": 0},
        "resolved_count": {"type": "integer", "minimum": 0},
        "unresolved_count": {"type": "integer", "minimum": 0}
      }
    }
  }
}
