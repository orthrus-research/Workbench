        "scope_key",
        "metadata_resource",
        "declared_epoch",
        "effective_epoch",
        "latest_supported_epoch",
        "fallback_epoch",
        "resolution_state",
        "evidence_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "compatibility_id": {
          "type": "string",
          "pattern": "^workbench-mixin-compatibility:sha256:[0-9a-f]{64}$"
        },
        "subject_kind": {
          "enum": [
            "artifact",
            "component",
            "configuration",
            "mixin-binding"
          ]
        },
        "subject_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "scope_kind": {
          "enum": [
            "artifact-default",
            "configuration",
            "mixin-class",
            "member"
          ]
        },
        "scope_key": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "metadata_resource": {
          "$ref": "#/$defs/resourceIdentity"
        },
        "declared_epoch": {
          "$ref": "#/$defs/nullableString"
        },
        "effective_epoch": {
          "$ref": "#/$defs/nullableString"
        },
        "latest_supported_epoch": {
          "$ref": "#/$defs/nullableString"
        },
        "fallback_epoch": {
          "$ref": "#/$defs/nullableString"
        },
        "resolution_state": {
          "enum": [
            "exact-metadata",
            "member-override",
            "mixin-inherited",
            "processor-default",
            "runtime-fallback",
            "invalid-metadata",
            "absent-metadata",
            "not-applicable",
            "unresolved"
          ]
        },
        "evidence_ids": {
          "$ref": "#/$defs/evidenceIds"
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "evidence_id",
        "evidence_kind",
        "collection_state",
        "admission_state",
        "truth_scope",
        "locator",
        "content_sha256",
        "size",
        "source_ids",
        "limitations"
      ],
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "type": "string",
          "pattern": "^workbench-mixin-evidence:sha256:[0-9a-f]{64}$"
        },
        "evidence_kind": {
          "enum": [
            "artifact-bytes",
            "jar-entry-bytes",
            "manifest",
            "service-provider-file",
            "mixin-config-resource",
            "compatibility-metadata",
            "refmap",
            "published-metadata",
            "source-span",
            "runtime-event",
            "runtime-query",
            "log",
            "intermediate-bytecode",
            "final-bytecode-fingerprint",
            "other"
          ]
        },
        "collection_state": {
          "enum": [
            "exact",
            "observed",
            "derived",
            "partial",
            "missing",
            "rejected"
          ]
        },
        "admission_state": {
          "enum": [
            "admitted",
            "supporting-only",
            "rejected"
          ]
        },
        "truth_scope": {
          "enum": [
            "artifact-identity",
            "static-declaration",
            "runtime-occurrence",
            "comparison-only",
            "diagnostic-only"
          ]
        },
        "locator": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "content_sha256": {
          "$ref": "#/$defs/nullableSha256"
        },
        "size": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "source_ids": {
          "$ref": "#/$defs/stringSet"
        },
        "limitations": {
          "$ref": "#/$defs/stringSet"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "collection_state": {
                "const": "exact"
              }
            },
            "required": [
              "collection_state"
            ]
          },
          "then": {
            "properties": {
              "content_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "size": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "collection_state": {
                "const": "missing"
              }
            },
            "required": [
              "collection_state"
            ]
          },
          "then": {
            "properties": {
              "content_sha256": {
                "type": "null"
              },
              "size": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "evidence_kind": {
                "enum": [
                  "log",
                  "intermediate-bytecode"
                ]
              }
            },
            "required": [
              "evidence_kind"
            ]
          },
          "then": {
            "properties": {
              "admission_state": {
                "const": "supporting-only"
              },
              "truth_scope": {
                "const": "diagnostic-only"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "admission_state": {
                "const": "admitted"
              }
            },
            "required": [
              "admission_state"
            ]
          },
          "then": {
            "properties": {
              "truth_scope": {
                "not": {
                  "const": "diagnostic-only"
                }
              }
            }
          }
        }
      ]
    },
