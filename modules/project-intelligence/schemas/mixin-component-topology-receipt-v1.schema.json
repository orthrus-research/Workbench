        "target",
        "operation_kind",
        "selector",
        "phase",
        "priority",
        "order_state",
        "application_state",
        "application_ordinal",
        "evidence_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "binding_id": {
          "type": "string",
