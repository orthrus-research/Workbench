            "observed-bounded",
            "rejected"
          ]
        },
        "compatibility_state": {
          "enum": [
            "complete",
            "partial",
            "not-applicable",
            "unresolved",
            "rejected"
          ]
        },
        "artifact_count": {
          "type": "integer",
          "minimum": 1
        },
        "component_count": {
          "type": "integer",
          "minimum": 1
        },
        "configuration_count": {
          "type": "integer",
          "minimum": 0
        },
        "registration_count": {
          "type": "integer",
          "minimum": 0
        },
        "mixin_binding_count": {
          "type": "integer",
