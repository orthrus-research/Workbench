{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://supersymmetry.dev/deconstruction/blueprints-simulation-evidence-v2.schema.json",
  "title": "Supersymmetry Blueprints private retained simulation observation v2",
  "type": "object",
  "required": [
    "schema_version", "format", "contract_id", "candidate_id", "plan_id",
    "target_state_id", "environment_lock_sha256", "authority_state_sha256",
    "baseline_manifest_sha256", "result_manifest_sha256", "gates",
    "status", "scratch_lease_id", "scratch_disposition",
    "git_supervision", "sandbox_supervision", "descendant_absence"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"git_supervision": {"const": "core-original-group-only"}}},
      "then": {"required": ["git_captures"]}
    },
    {
      "if": {"properties": {"git_supervision": {"const": "direct-child-wait-only"}}},
      "then": {"not": {"required": ["git_captures"]}}
    }
  ],
  "properties": {
    "schema_version": {"const": 2},
    "format": {"const": "susy-blueprints-simulation-evidence-v2"},
    "contract_id": {"const": "BLUEPRINTS-EXECUTABLE-ENGINE-V1"},
    "candidate_id": {"type": "string", "pattern": "^blueprints-candidate:sha256:[0-9a-f]{64}$"},
    "plan_id": {"type": "string", "pattern": "^blueprints-plan:sha256:[0-9a-f]{64}$"},
    "target_state_id": {"type": "string", "pattern": "^blueprints-target-state:sha256:[0-9a-f]{64}$"},
    "environment_lock_sha256": {"$ref": "#/$defs/sha256"},
    "authority_state_sha256": {"$ref": "#/$defs/sha256"},
    "baseline_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "result_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "ordinal", "stage_id", "status", "reason_code", "command_sha256",
          "exit_code", "timed_out", "stdout_sha256", "stderr_sha256",
          "evidence_sha256"
        ],
        "additionalProperties": false,
        "properties": {
          "ordinal": {"type": "integer", "minimum": 0},
          "stage_id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]*$"},
          "status": {"enum": ["passed", "failed", "unavailable"]},
          "reason_code": {"type": "string", "pattern": "^BPX[0-9]{3}_[A-Z0-9_]+$"},
          "command_sha256": {
            "oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]
          },
          "exit_code": {"type": ["integer", "null"]},
          "timed_out": {"type": "boolean"},
          "stdout_sha256": {"$ref": "#/$defs/sha256"},
          "stderr_sha256": {"$ref": "#/$defs/sha256"},
          "evidence_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "status": {"const": "observed-unqualified"},
    "scratch_lease_id": {
      "type": "string", "pattern": "^workbench-temporary-lease-v1:[0-9a-f]{32}$"
    },
    "scratch_disposition": {"const": "retained-process-absence-unproven"},
    "git_supervision": {"enum": ["direct-child-wait-only", "core-original-group-only"]},
    "git_captures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["attempt", "capture_id"],
        "additionalProperties": false,
        "properties": {
          "attempt": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
          "capture_id": {
            "type": "string", "pattern": "^process-capture:sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "sandbox_supervision": {"const": "initial-process-group-only"},
    "descendant_absence": {"const": "unproven"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
