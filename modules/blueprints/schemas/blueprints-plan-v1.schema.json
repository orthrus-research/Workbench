{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://supersymmetry.dev/deconstruction/blueprints-plan-v1.schema.json",
  "title": "Supersymmetry Blueprints immutable plan v1",
  "type": "object",
  "required": [
    "schema_version",
    "format",
    "contract_id",
    "plan_id",
    "request_id",
    "target_state_id",
    "standards",
    "selection",
    "effective_parameters",
    "atlas",
    "authorized_paths",
    "operations",
    "validation_stages",
    "status",
    "blocked_reasons"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "format": {
      "const": "susy-blueprints-plan-v1"
    },
    "contract_id": {
      "const": "BLUEPRINTS-EXECUTABLE-ENGINE-V1"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^blueprints-plan:sha256:[0-9a-f]{64}$"
    },
    "request_id": {
      "type": "string",
      "pattern": "^blueprints-request:sha256:[0-9a-f]{64}$"
    },
    "target_state_id": {
      "type": "string",
      "pattern": "^blueprints-target-state:sha256:[0-9a-f]{64}$"
    },
    "standards": {
      "type": "object",
      "required": [
        "primary",
        "components"
      ],
      "additionalProperties": false,
      "properties": {
        "primary": {
          "type": "object",
          "required": [
            "standard_id",
            "standard_sha256",
            "version"
          ],
          "additionalProperties": false,
          "properties": {
            "standard_id": {
              "type": "string",
              "pattern": "^blueprints-standard:sha256:[0-9a-f]{64}$"
            },
            "standard_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "standard_id",
              "standard_sha256",
              "version"
            ],
            "additionalProperties": false,
            "properties": {
              "standard_id": {
                "type": "string",
                "pattern": "^blueprints-standard:sha256:[0-9a-f]{64}$"
              },
              "standard_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "version": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "selection": {
      "type": "object",
      "required": [
        "variant_ids",
        "rationale_codes",
        "developer_choice_required"
      ],
      "additionalProperties": false,
      "properties": {
        "variant_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]*$"
          }
        },
        "rationale_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        },
        "developer_choice_required": {
          "type": "boolean"
        }
      }
    },
    "effective_parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "class",
          "value",
          "origin",
          "accepted"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "class": {
            "enum": [
              "required",
              "derived",
              "allocated",
              "defaulted",
              "optional"
            ]
          },
          "value": {
            "type": [
              "string",
              "integer",
              "number",
              "boolean",
              "object",
              "array",
              "null"
            ]
          },
          "origin": {
            "type": "string",
            "minLength": 1
          },
          "accepted": {
            "type": "boolean"
          }
        }
      }
    },
    "atlas": {
      "type": "object",
      "required": [
        "baseline_id",
        "current_id",
        "relevant_drift",
        "invariant_results"
      ],
      "additionalProperties": false,
      "properties": {
        "baseline_id": {
          "type": "string",
          "minLength": 1
        },
        "current_id": {
          "type": "string",
          "minLength": 1
        },
        "relevant_drift": {
          "enum": [
            "none",
            "blocking"
          ]
        },
        "invariant_results": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "invariant_id",
              "status",
              "evidence_sha256"
            ],
            "additionalProperties": false,
            "properties": {
              "invariant_id": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "pass",
                  "fail",
                  "unavailable"
                ]
              },
              "evidence_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "authorized_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[^/\\\\](?:[^\\\\]*[^/\\\\])?/$"
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ordinal",
          "operation",
          "path",
          "content_sha256"
        ],
        "additionalProperties": false,
        "properties": {
          "ordinal": {
            "type": "integer",
            "minimum": 0
          },
          "operation": {
            "enum": [
              "create",
              "update",
              "delete"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^[^/\\\\](?:.*[^/\\\\])?$"
          },
          "content_sha256": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            ]
          }
        }
      }
    },
    "validation_stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "ordinal",
          "stage_id",
          "kind",
          "required"
        ],
        "additionalProperties": false,
        "properties": {
          "ordinal": {
            "type": "integer",
            "minimum": 0
          },
          "stage_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]*$"
          },
          "kind": {
            "enum": [
              "static",
              "format",
              "compile",
              "test",
              "runtime",
              "presentation",
              "integration",
              "formed-world"
            ]
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    },
    "status": {
      "enum": [
        "ready",
        "blocked"
      ]
    },
    "blocked_reasons": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
