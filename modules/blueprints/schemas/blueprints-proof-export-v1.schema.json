{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://supersymmetry.dev/deconstruction/blueprints-proof-export-v1.schema.json",
  "title": "Supersymmetry Blueprints portable proof export v1",
  "type": "object",
  "required": [
    "schema_version",
    "format",
    "contract_id",
    "manifest",
    "proof",
    "artifacts"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "format": {
      "const": "susy-blueprints-proof-export-v1"
    },
    "contract_id": {
      "const": "BLUEPRINTS-EXECUTABLE-ENGINE-V1"
    },
    "manifest": {
      "type": "object",
      "required": [
        "closure",
        "run_id",
        "excludes_private",
        "artifacts"
      ],
      "additionalProperties": false,
      "properties": {
        "closure": {
          "enum": [
            "release-validated",
            "target-verified"
          ]
        },
        "run_id": {
          "type": "string",
          "pattern": "^blueprints-run:sha256:[0-9a-f]{64}$"
        },
        "excludes_private": {
          "const": true
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "artifact_id",
              "kind",
              "sha256"
            ],
            "additionalProperties": false,
            "properties": {
              "artifact_id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "manifest",
                  "source",
                  "patch",
                  "evidence"
                ]
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "proof": {
      "type": "object"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "artifact_id",
          "sha256",
          "content_base64"
        ],
        "additionalProperties": false,
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "content_base64": {
            "type": "string",
            "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
          }
        }
      }
    }
  }
}
