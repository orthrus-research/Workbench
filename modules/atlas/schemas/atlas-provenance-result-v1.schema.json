{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://supersymmetry.dev/deconstruction/atlas-provenance-result-v1.schema.json",
  "title": "Supersymmetry Atlas causal provenance result v1",
  "type": "object",
  "required": [
    "schema_version",
    "format",
    "result_id",
    "request",
    "status",
    "closure",
    "nodes",
    "relations",
    "paths",
    "evidence",
    "negative_statements",
    "truncation",
    "pagination"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "format": {
      "const": "susy-atlas-causal-provenance-result-v1"
    },
    "result_id": {
      "type": "string",
      "pattern": "^atlas-provenance-result:sha256:[0-9a-f]{64}$"
    },
    "request": {
      "type": "object"
    },
    "status": {
      "enum": [
        "closed",
        "partial",
        "bounded",
        "unresolved",
        "unavailable"
      ]
    },
    "closure": {
      "type": "object",
      "required": [
        "state",
        "reason_codes",
        "open_frontier_node_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "closed",
            "partial",
            "bounded",
            "unresolved",
            "unavailable"
          ]
        },
        "reason_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "dynamic-script-unresolved",
              "source-span-unavailable",
              "runtime-transition-unobserved",
              "lifecycle-order-unresolved",
              "identity-reconciliation-unresolved",
              "required-evidence-unavailable",
              "path-bound-reached",
              "node-bound-reached",
              "relation-bound-reached",
              "evidence-bound-reached"
            ]
          }
        },
        "open_frontier_node_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^atlas-provenance-node:sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "node_id",
          "node_class",
          "scope",
          "identity",
          "evidence_ids"
        ],
        "additionalProperties": false,
        "properties": {
          "node_id": {
            "type": "string",
            "pattern": "^atlas-provenance-node:sha256:[0-9a-f]{64}$"
          },
          "node_class": {
            "enum": [
              "source-span",
              "declared-object",
              "configuration-entry",
              "script-operation",
              "lifecycle-event",
              "runtime-state",
              "final-runtime-record",
              "explanation"
            ]
          },
          "scope": {
            "type": "object",
            "required": [
              "snapshot_id",
              "profile",
              "physical_side"
            ],
            "additionalProperties": false,
            "properties": {
              "snapshot_id": {
                "type": "string",
                "pattern": "^SNAPSHOT-[A-Z0-9-]+$"
              },
              "profile": {
                "enum": [
                  "COMMON_FINAL_STATE",
                  "CLIENT_JEI_FINAL_STATE",
                  "OFFLINE_ARTIFACT_STATE"
                ]
              },
              "physical_side": {
                "enum": [
                  "CLIENT",
                  "DEDICATED_SERVER",
                  "OFFLINE"
                ]
              }
            }
          },
          "identity": {
            "type": "object"
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^atlas-provenance-evidence:sha256:[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "relation_id",
          "predicate",
          "subject_node_id",
          "object_node_id",
          "causal_strength",
          "lifecycle_stage_id",
          "evidence_ids"
        ],
        "additionalProperties": false,
        "properties": {
          "relation_id": {
            "type": "string",
            "pattern": "^atlas-provenance-relation:sha256:[0-9a-f]{64}$"
          },
          "predicate": {
            "enum": [
              "declares",
              "registers",
              "loads_configuration",
              "invokes",
              "copies",
              "transforms",
              "mutates",
              "removes",
              "replaces",
              "reconciles_to",
              "observed_as_final",
              "derives_explanation"
            ]
          },
          "subject_node_id": {
            "type": "string",
            "pattern": "^atlas-provenance-node:sha256:[0-9a-f]{64}$"
          },
          "object_node_id": {
            "type": "string",
            "pattern": "^atlas-provenance-node:sha256:[0-9a-f]{64}$"
          },
          "causal_strength": {
            "enum": [
              "ownership",
              "possibility",
              "participation",
              "transformation",
              "causation",
              "identity",
              "observation",
              "derivation"
            ]
          },
          "lifecycle_stage_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^atlas-provenance-evidence:sha256:[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "paths": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path_id",
          "node_ids",
          "relation_ids",
          "closure_state",
          "open_reason_codes"
        ],
        "additionalProperties": false,
        "properties": {
          "path_id": {
            "type": "string",
            "pattern": "^atlas-provenance-path:sha256:[0-9a-f]{64}$"
          },
          "node_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^atlas-provenance-node:sha256:[0-9a-f]{64}$"
            }
          },
          "relation_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^atlas-provenance-relation:sha256:[0-9a-f]{64}$"
            }
          },
          "closure_state": {
            "enum": [
              "closed",
              "partial"
            ]
          },
          "open_reason_codes": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "dynamic-script-unresolved",
                "source-span-unavailable",
                "runtime-transition-unobserved",
                "lifecycle-order-unresolved",
                "identity-reconciliation-unresolved",
                "required-evidence-unavailable",
                "path-bound-reached",
                "node-bound-reached",
                "relation-bound-reached",
                "evidence-bound-reached"
              ]
            }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "evidence_id",
          "authority",
          "record_kind",
          "record",
          "record_sha256"
        ],
        "additionalProperties": false,
        "properties": {
          "evidence_id": {
            "type": "string",
            "pattern": "^atlas-provenance-evidence:sha256:[0-9a-f]{64}$"
          },
          "authority": {
            "enum": [
              "pinned-source",
              "runtime-mechanics",
              "derived-validation"
            ]
          },
          "record_kind": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "record": {
            "type": "object"
          },
          "record_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "negative_statements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "statement_id",
          "kind",
          "subject_node_id",
          "authority_evidence_ids",
          "bounded_wording"
        ],
        "additionalProperties": false,
        "properties": {
          "statement_id": {
            "type": "string",
            "pattern": "^atlas-provenance-statement:sha256:[0-9a-f]{64}$"
          },
          "kind": {
            "enum": [
              "not-found-in-closed-source-scope",
              "not-observed-in-final-capture",
              "removed-before-final",
              "no-closed-causal-path"
            ]
          },
          "subject_node_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "authority_evidence_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^atlas-provenance-evidence:sha256:[0-9a-f]{64}$"
            }
          },
          "bounded_wording": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "truncation": {
      "type": "object",
      "required": [
        "truncated",
        "reason",
        "emitted_paths",
        "emitted_nodes",
        "emitted_relations",
        "emitted_evidence_records",
        "omitted_at_least"
      ],
      "additionalProperties": false,
      "properties": {
        "truncated": {
          "type": "boolean"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "emitted_paths": {
          "type": "integer",
          "minimum": 0
        },
        "emitted_nodes": {
          "type": "integer",
          "minimum": 0
        },
        "emitted_relations": {
          "type": "integer",
          "minimum": 0
        },
        "emitted_evidence_records": {
          "type": "integer",
          "minimum": 0
        },
        "omitted_at_least": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "pagination": {
      "type": "object",
      "required": [
        "mode",
        "continuation"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "const": "none-v1-single-bounded-result"
        },
        "continuation": {
          "type": "null"
        }
      }
    }
  }
}
