{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://supersymmetry.dev/deconstruction/corpus-link-v1.schema.json",
  "title": "Supersymmetry Unified Process Atlas exact corpus link v1",
  "type": "object",
  "required": [
    "id",
    "snapshot_id",
    "canonical_entity_id",
    "observed_id",
    "observed_kind",
    "basis",
    "key_kind",
    "key_value",
    "profile_scope"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^LINK-[A-Z0-9-]+$"
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^SNAPSHOT-[A-Z0-9-]+$"
    },
    "canonical_entity_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]+$"
    },
    "observed_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "observed_kind": {
      "enum": [
        "runtime-node",
        "quest-node",
        "quest-task",
        "quest-reward"
      ]
    },
    "basis": {
      "enum": [
        "exact-typed-key",
        "reviewed-override"
      ]
    },
    "key_kind": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "key_value": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "profile_scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?:COMMON_FINAL_STATE/(?:CLIENT|DEDICATED_SERVER)|CLIENT_JEI_FINAL_STATE/CLIENT|OFFLINE_ARTIFACT_STATE/OFFLINE)$"
      }
    }
  }
}
