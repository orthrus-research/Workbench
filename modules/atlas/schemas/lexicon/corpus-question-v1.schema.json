{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://supersymmetry.dev/deconstruction/corpus-question-v1.schema.json",
  "title": "Supersymmetry Unified Process Atlas acceptance question v1",
  "type": "object",
  "required": [
    "id",
    "question",
    "audience",
    "query",
    "selector",
    "required_fields",
    "required_evidence_bases",
    "status"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(?:DEVELOPER|PLAYER)-[A-Z0-9]+(?:-[A-Z0-9]+)*-[0-9]{3}$"
    },
    "question": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "audience": {
      "enum": [
        "developer",
        "player"
      ]
    },
    "query": {
      "enum": [
        "show",
        "producers",
        "consumers",
        "machine-recipes",
        "chain",
        "quests",
        "compare",
        "explain"
      ]
    },
    "selector": {
      "type": "object",
      "required": [
        "kind",
        "key"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "material",
            "item",
            "fluid",
            "ore-dictionary",
            "ore-prefix",
            "recipe",
            "recipe-map",
            "machine",
            "quest",
            "entity"
          ]
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$"
        }
      }
    },
    "required_fields": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)*$"
      }
    },
    "required_evidence_bases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "runtime-mechanics",
          "runtime-presentation",
          "pinned-source",
          "quest-data",
          "curated-interpretation",
          "unresolved"
        ]
      }
    },
    "status": {
      "enum": [
        "active",
        "deferred",
        "retired"
      ]
    }
  }
}
