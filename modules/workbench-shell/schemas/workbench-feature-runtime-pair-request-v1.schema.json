{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workbench://schemas/workbench-shell/workbench-feature-runtime-pair-request-v1.schema.json",
  "title": "Workbench feature physical-side pair request V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format", "schema_version", "request_id", "change_id", "plan_id",
    "comparison", "side", "order", "attempt_id", "roles",
    "required_assertions"
  ],
  "properties": {
    "format": {"const": "workbench-feature-runtime-pair-request-v1"},
    "schema_version": {"const": 1},
    "request_id": {
      "type": "string",
      "pattern": "^workbench-feature-runtime-pair-request:sha256:[0-9a-f]{64}$"
    },
    "change_id": {
      "type": "string",
      "pattern": "^workbench-feature-change:sha256:[0-9a-f]{64}$"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:sha256:[0-9a-f]{64}$"
    },
    "comparison": {"enum": ["aa", "ab", "post-apply", "post-rollback"]},
    "side": {"enum": ["client", "server"]},
    "order": {"enum": ["baseline-first", "candidate-first"]},
    "attempt_id": {
      "type": "string",
      "pattern": "^(matrix|post-apply|post-rollback)-[0-9a-f]{32}$"
    },
    "roles": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {"enum": ["baseline", "candidate"]}
    },
    "required_assertions": {
      "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
    }
  }
}
