{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workbench://schemas/workbench-shell/workbench-diagnosis-v1.schema.json",
  "title": "Workbench evidence-bounded diagnosis V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format", "schema_version", "diagnosis_id", "work_session_id", "outcome",
    "target_owner_ref", "current_owner_ref", "command", "timeline",
    "observed_failures", "wrappers", "secondary_failures", "shutdown_noise",
    "contributing_conditions", "classifications", "unknowns", "next_experiments",
    "fingerprint", "limitations"
  ],
  "properties": {
    "format": {"const": "workbench-diagnosis-v1"},
    "schema_version": {"const": 1},
    "diagnosis_id": {"type": "string", "pattern": "^workbench-diagnosis:sha256:[0-9a-f]{64}$"},
    "work_session_id": {"oneOf": [{"$ref": "#/$defs/identity"}, {"type": "null"}]},
    "outcome": {"enum": ["failed", "inconclusive"]},
    "target_owner_ref": {"$ref": "#/$defs/ownerRef"},
    "current_owner_ref": {"$ref": "#/$defs/ownerRef"},
    "command": {
      "type": "object", "additionalProperties": false,
      "required": ["command_id", "intent", "shell"],
      "properties": {
        "command_id": {"$ref": "#/$defs/identity"},
        "intent": {"enum": ["inspect", "execute"]},
        "shell": {"type": "boolean"}
      }
    },
    "timeline": {"type": "array", "minItems": 1, "maxItems": 100000, "items": {"$ref": "#/$defs/event"}},
    "observed_failures": {"$ref": "#/$defs/claims"},
    "wrappers": {"$ref": "#/$defs/claims"},
    "secondary_failures": {"$ref": "#/$defs/claims"},
    "shutdown_noise": {"$ref": "#/$defs/claims"},
    "contributing_conditions": {"$ref": "#/$defs/claims"},
    "classifications": {
      "type": "array", "maxItems": 256,
      "items": {"$ref": "#/$defs/classification"}
    },
    "unknowns": {
      "type": "array", "minItems": 1, "maxItems": 256,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "claim_state", "owner_id", "detail"],
        "properties": {
          "id": {"$ref": "#/$defs/identity"},
          "claim_state": {"const": "unknown"},
          "owner_id": {"$ref": "#/$defs/identity"},
          "detail": {"type": "string", "minLength": 1, "maxLength": 8192}
        }
      }
    },
    "next_experiments": {
      "type": "array", "minItems": 1, "maxItems": 128,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["action_id", "arguments", "context_digest", "mutation"],
        "properties": {
          "action_id": {"$ref": "#/$defs/identity"},
          "arguments": {"type": "object", "maxProperties": 64},
          "context_digest": {"$ref": "#/$defs/digest"},
          "mutation": {"enum": ["read-only", "isolated-target-only"]}
        }
      }
    },
    "fingerprint": {"$ref": "#/$defs/digest"},
    "limitations": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"type": "string", "minLength": 1, "maxLength": 8192}}
  },
  "$defs": {
    "identity": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/+@=-]*$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "ownerRef": {
      "type": "object", "additionalProperties": false,
      "required": ["owner_id", "record_id", "record_kind", "uri", "digest", "last_verified_state"],
      "properties": {
        "owner_id": {"$ref": "#/$defs/identity"},
        "record_id": {"$ref": "#/$defs/identity"},
        "record_kind": {"$ref": "#/$defs/identity"},
        "uri": {"type": "string", "format": "uri", "minLength": 3, "maxLength": 8192},
        "digest": {"$ref": "#/$defs/digest"},
        "last_verified_state": {"$ref": "#/$defs/identity"}
      }
    },
    "rawRange": {
      "type": "object", "additionalProperties": false,
      "required": ["stream", "artifact", "byte_start", "byte_end", "boundary"],
      "properties": {
        "stream": {"type": "string", "minLength": 1, "maxLength": 48, "pattern": "^[a-z][a-z0-9-]*$"},
        "artifact": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
        "byte_start": {"type": "integer", "minimum": 0},
        "byte_end": {"type": "integer", "minimum": 1},
        "boundary": {"enum": ["lf", "crlf", "cr", "limit", "eof"]}
      }
    },
    "event": {
      "type": "object", "additionalProperties": false,
      "required": ["event_id", "sequence", "kind", "severity", "subsystem", "message", "raw_range"],
      "properties": {
        "event_id": {"$ref": "#/$defs/identity"},
        "sequence": {"type": "integer", "minimum": 1},
        "kind": {"$ref": "#/$defs/identity"},
        "severity": {"enum": ["trace", "debug", "info", "warning", "error", "fatal", "unknown"]},
        "subsystem": {"$ref": "#/$defs/identity"},
        "message": {"type": "string", "maxLength": 1048576},
        "raw_range": {"$ref": "#/$defs/rawRange"}
      }
    },
    "claim": {
      "type": "object", "additionalProperties": false,
      "required": ["event_id", "sequence", "kind", "severity", "subsystem", "message", "raw_range", "claim_state", "owner_id"],
      "properties": {
        "event_id": {"$ref": "#/$defs/identity"},
        "sequence": {"type": "integer", "minimum": 1},
        "kind": {"$ref": "#/$defs/identity"},
        "severity": {"enum": ["trace", "debug", "info", "warning", "error", "fatal", "unknown"]},
        "subsystem": {"$ref": "#/$defs/identity"},
        "message": {"type": "string", "maxLength": 1048576},
        "raw_range": {"$ref": "#/$defs/rawRange"},
        "claim_state": {"enum": ["observed", "derived", "suspected", "unknown"]},
        "owner_id": {"$ref": "#/$defs/identity"}
      }
    },
    "claims": {"type": "array", "maxItems": 100000, "items": {"$ref": "#/$defs/claim"}},
    "classification": {
      "type": "object", "additionalProperties": false,
      "required": [
        "classification_id", "claim_state", "owner_id", "owner_record_id",
        "owner_record_kind", "owner_record_uri", "owner_record_digest",
        "stage", "state", "required_markers", "observed_markers",
        "effective_exit_code", "cleanup_contained", "artifact_digest", "detail"
      ],
      "properties": {
        "classification_id": {"const": "cleanroom-dev-loop-stage"},
        "claim_state": {"const": "observed"},
        "owner_id": {"const": "workbench-shell"},
        "owner_record_id": {"$ref": "#/$defs/identity"},
        "owner_record_kind": {"const": "workbench-cleanroom-dev-loop-receipt"},
        "owner_record_uri": {"type": "string", "format": "uri", "minLength": 3, "maxLength": 8192},
        "owner_record_digest": {"$ref": "#/$defs/digest"},
        "stage": {"enum": ["build", "client", "server"]},
        "state": {"enum": ["not-run", "passed", "failed"]},
        "required_markers": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
        "observed_markers": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
        "effective_exit_code": {"oneOf": [{"type": "integer", "minimum": 0, "maximum": 255}, {"type": "null"}]},
        "cleanup_contained": {"oneOf": [{"type": "boolean"}, {"type": "null"}]},
        "artifact_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "detail": {"type": "string", "minLength": 1, "maxLength": 8192}
      }
    }
  }
}
