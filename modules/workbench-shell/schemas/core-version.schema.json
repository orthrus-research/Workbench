{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workbench://schemas/workbench-shell/core-version.schema.json",
  "title": "Native Workbench Core version",
  "type": "object",
  "additionalProperties": false,
  "required": ["component_id", "version"],
  "properties": {
    "component_id": {"const": "workbench-core"},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:(?:a|b|rc)[1-9][0-9]*)?$"}
  }
}
