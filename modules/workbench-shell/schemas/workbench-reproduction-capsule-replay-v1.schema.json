{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workbench://schemas/workbench-shell/workbench-reproduction-capsule-replay-v1.schema.json",
  "title": "Workbench Reproduction Capsule replay V1",
  "type": "object", "additionalProperties": false,
  "required": ["format", "schema_version", "capsule_id", "diagnosis_id", "action_id", "outcome", "expected_fingerprint", "observed_fingerprint", "matched"],
  "properties": {
    "format": {"const": "workbench-reproduction-capsule-replay-v1"},
    "schema_version": {"const": 1},
    "capsule_id": {"type": "string", "pattern": "^workbench-reproduction-capsule:sha256:[0-9a-f]{64}$"},
    "diagnosis_id": {"type": "string", "pattern": "^workbench-diagnosis:sha256:[0-9a-f]{64}$"},
    "action_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,255}$"},
    "outcome": {"enum": ["matching-failure", "divergent-failure", "unexpected-success", "blocked-hydration", "cancelled", "incomplete"]},
    "expected_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "observed_fingerprint": {"oneOf": [{"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, {"type": "null"}]},
    "matched": {"type": "boolean"}
  }
}
