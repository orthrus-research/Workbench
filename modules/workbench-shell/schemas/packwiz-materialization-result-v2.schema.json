{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workbench.invalid/schemas/packwiz-materialization-result-v2.schema.json",
  "title": "Workbench local Packwiz materialization result V2",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schema_version", "outcome", "receipt"],
  "properties": {
    "format": {
      "const": "workbench-packwiz-materialization-result-v2"
    },
    "schema_version": {
      "const": 2
    },
    "outcome": {
      "enum": ["installed", "reused"]
    },
    "receipt": {
      "$ref": "https://workbench.invalid/schemas/packwiz-materialization-receipt-v2.schema.json"
    },
    "bootstrap_outcome": {
      "type": "string",
      "minLength": 1
    },
    "java_outcome": {
      "type": "string",
      "minLength": 1
    },
    "installer_artifact_outcome": {
      "type": "string",
      "minLength": 1
    }
  }
}
