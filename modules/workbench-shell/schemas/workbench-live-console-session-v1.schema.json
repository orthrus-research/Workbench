{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workbench://schemas/workbench-shell/workbench-live-console-session-v1.schema.json",
  "title": "Workbench live console retained session V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "session_id",
    "state",
    "started_at",
    "updated_at",
    "command",
    "retention",
    "summary"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "running"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "ended_at"
              ]
            },
            {
              "required": [
                "exit"
              ]
            }
          ]
        }
      },
      "else": {
        "required": [
          "ended_at",
          "exit"
        ]
      }
    }
  ],
  "properties": {
    "format_version": {
      "const": "workbench-live-console-session-v1"
    },
    "session_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "state": {
      "enum": [
        "running",
        "complete",
        "failed",
        "cancelled",
        "incomplete"
      ]
    },
    "started_at": {
      "$ref": "#/$defs/timestamp"
    },
    "updated_at": {
      "$ref": "#/$defs/timestamp"
    },
    "ended_at": {
      "$ref": "#/$defs/timestamp"
    },
    "command": {
      "$ref": "#/$defs/command"
    },
    "retention": {
      "$ref": "#/$defs/retention"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "exit": {
      "$ref": "#/$defs/exit"
    },
    "limitations": {
      "$ref": "#/$defs/limitations"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/+@=-]*$"
    },
    "singleLine": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "pattern": "^[^\\r\\n\\u0000]+$"
    },
    "nullableSingleLine": {
      "oneOf": [
        {
          "$ref": "#/$defs/singleLine"
        },
        {
          "type": "null"
        }
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "nullablePositiveInteger": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "path": {
      "allOf": [
        {
          "$ref": "#/$defs/singleLine"
        },
        {
          "not": {
            "pattern": "(^|[\\\\/])\\.\\.([\\\\/]|$)"
          }
        }
      ]
    },
    "argvToken": {
      "type": "string",
      "maxLength": 1048576,
      "pattern": "^[^\\u0000]*$"
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command_id",
        "label",
        "argv",
        "cwd",
        "intent",
        "shell",
        "pid",
        "process_group_id"
      ],
      "properties": {
        "command_id": {
          "$ref": "#/$defs/identifier"
        },
        "label": {
          "$ref": "#/$defs/nullableSingleLine"
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/argvToken"
          }
        },
        "cwd": {
          "$ref": "#/$defs/path"
        },
        "intent": {
          "enum": [
            "execute",
            "preview",
            "inert",
            "inspect"
          ]
        },
        "shell": {
          "const": false
        },
        "pid": {
          "$ref": "#/$defs/nullablePositiveInteger"
        },
        "process_group_id": {
          "$ref": "#/$defs/nullablePositiveInteger"
        }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "directory",
        "events",
        "raw_streams",
        "raw_is_source_record",
        "events_are_projection"
      ],
      "properties": {
        "directory": {
          "allOf": [
            {
              "$ref": "#/$defs/path"
            },
            {
              "pattern": "[\\\\/]\\.workbench[\\\\/]sessions[\\\\/]live-console[\\\\/][A-Za-z0-9._-]+$"
            }
          ]
        },
        "events": {
          "const": "events-v1.jsonl"
        },
        "raw_streams": {
          "type": "object",
          "maxProperties": 16,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9-]{0,47}$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 5,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9-]{0,47}\\.raw$"
          }
        },
        "raw_is_source_record": {
          "const": true
        },
        "events_are_projection": {
          "const": true
        }
      }
    },
    "countMap": {
      "type": "object",
      "maxProperties": 256,
      "propertyNames": {
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_count",
        "severity_counts",
        "subsystem_counts",
        "kind_counts",
        "outcome_failure_events",
        "source_locator_count"
      ],
      "properties": {
        "event_count": {
          "type": "integer",
          "minimum": 0
        },
        "severity_counts": {
          "$ref": "#/$defs/countMap"
        },
        "subsystem_counts": {
          "$ref": "#/$defs/countMap"
        },
        "kind_counts": {
          "$ref": "#/$defs/countMap"
        },
        "outcome_failure_events": {
          "type": "integer",
          "minimum": 0
        },
        "source_locator_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "exit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "process_exit_code",
        "effective_exit_code",
        "outcome",
        "cancellation"
      ],
      "properties": {
        "process_exit_code": {
          "oneOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "effective_exit_code": {
          "type": "integer",
          "minimum": 0
        },
        "outcome": {
          "$ref": "#/$defs/singleLine"
        },
        "cancellation": {
          "$ref": "#/$defs/nullableSingleLine"
        }
      }
    },
    "limitations": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/singleLine"
      }
    }
  }
}
