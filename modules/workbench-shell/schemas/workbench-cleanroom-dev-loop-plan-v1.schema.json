{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workbench://schemas/workbench-shell/workbench-cleanroom-dev-loop-plan-v1.schema.json",
  "title": "Workbench Cleanroom generic fixture dev-loop plan V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format", "schema_version", "kind", "plan_id", "operation_class", "state",
    "request", "fixture", "toolchain", "state_root_uri", "target_root_uri",
    "stages", "limitations"
  ],
  "properties": {
    "format": {"const": "workbench-cleanroom-dev-loop-plan-v1"},
    "schema_version": {"const": 1},
    "kind": {"const": "workbench-cleanroom-dev-loop-plan"},
    "plan_id": {
      "type": "string",
      "pattern": "^workbench-cleanroom-dev-loop-plan:sha256:[0-9a-f]{64}$"
    },
    "operation_class": {"const": "read-only-plan"},
    "state": {"const": "ready"},
    "request": {
      "type": "object", "additionalProperties": false,
      "required": ["sides", "debug"],
      "properties": {
        "sides": {
          "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true,
          "items": {"enum": ["client", "server"]}
        },
        "debug": {"const": false}
      }
    },
    "fixture": {
      "type": "object", "additionalProperties": false,
      "required": ["fixture_id", "digest", "source_uri"],
      "properties": {
        "fixture_id": {"const": "workbench-fixture:cleanroom:generic-mod-daily-loop"},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "source_uri": {"$ref": "#/$defs/fileUri"}
      }
    },
    "toolchain": {
      "type": "object", "additionalProperties": false,
      "required": ["gradle", "java", "cleanup_init", "environment"],
      "properties": {
        "gradle": {"type": "object", "minProperties": 1},
        "java": {"type": "object", "minProperties": 1},
        "cleanup_init": {"type": "object", "minProperties": 1},
        "environment": {
          "type": "object", "additionalProperties": false,
          "required": ["JAVA_HOME", "GRADLE_USER_HOME"],
          "properties": {
            "JAVA_HOME": {"type": "string", "minLength": 1, "maxLength": 8192},
            "GRADLE_USER_HOME": {"type": "string", "minLength": 1, "maxLength": 8192}
          }
        }
      }
    },
    "state_root_uri": {"$ref": "#/$defs/fileUri"},
    "target_root_uri": {"$ref": "#/$defs/fileUri"},
    "stages": {
      "type": "object", "minProperties": 2, "maxProperties": 3,
      "required": ["build"],
      "propertyNames": {"enum": ["build", "client", "server"]},
      "additionalProperties": {"$ref": "#/$defs/stage"}
    },
    "limitations": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {"type": "string", "minLength": 1, "maxLength": 4096}
    }
  },
  "$defs": {
    "fileUri": {"type": "string", "pattern": "^file:/", "maxLength": 8192},
    "stage": {
      "type": "object", "additionalProperties": false,
      "required": ["argv", "cwd_uri"],
      "properties": {
        "argv": {
          "type": "array", "minItems": 1, "maxItems": 256,
          "items": {"type": "string", "maxLength": 16384}
        },
        "cwd_uri": {"$ref": "#/$defs/fileUri"},
        "expected_artifact_uri": {"$ref": "#/$defs/fileUri"},
        "required_markers": {
          "type": "array", "minItems": 1, "maxItems": 8,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}
        },
        "target_root_uri": {"$ref": "#/$defs/fileUri"},
        "preparation": {"$ref": "#/$defs/serverPreparation"}
      }
    },
    "serverPreparation": {
      "type": "object", "additionalProperties": false,
      "required": ["operation", "scope", "target_uri", "sha256", "size"],
      "properties": {
        "operation": {"const": "materialize-isolated-server-eula"},
        "scope": {"const": "fresh-isolated-run-target"},
        "target_uri": {"$ref": "#/$defs/fileUri"},
        "sha256": {
          "const": "sha256:ee27072e4a23e088522f740ddaab0c7c4145c186969e90a86254faa3a5ec5ce6"
        },
        "size": {"const": 10}
      }
    }
  }
}
