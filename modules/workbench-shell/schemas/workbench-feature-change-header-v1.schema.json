{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workbench://schemas/workbench-shell/workbench-feature-change-header-v1.schema.json",
  "title": "Workbench feature change immutable header V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format", "schema_version", "change_id", "intent", "plan_id",
    "plan_uri", "workspace_uri", "transaction_root_uri", "limitations"
  ],
  "properties": {
    "format": {"const": "workbench-feature-change-header-v1"},
    "schema_version": {"const": 1},
    "change_id": {"$ref": "#/$defs/changeId"},
    "intent": {"const": "supersymmetry-material-backed-fluid-recipe"},
    "plan_id": {"$ref": "#/$defs/contentId"},
    "plan_uri": {"$ref": "#/$defs/fileUri"},
    "workspace_uri": {"$ref": "#/$defs/fileUri"},
    "transaction_root_uri": {"$ref": "#/$defs/fileUri"},
    "limitations": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {"type": "string", "minLength": 1, "maxLength": 4096}
    }
  },
  "$defs": {
    "changeId": {
      "type": "string",
      "pattern": "^workbench-feature-change:sha256:[0-9a-f]{64}$"
    },
    "contentId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:sha256:[0-9a-f]{64}$"
    },
    "fileUri": {"type": "string", "pattern": "^file:/", "maxLength": 8192}
  }
}
