{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workbench.invalid/schemas/runtime-plan-v1.schema.json",
  "title": "Workbench read-only runtime plan V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schema_version",
    "plan_id",
    "operation_class",
    "state",
    "request",
    "workspace",
    "project",
    "target",
    "artifacts",
    "intended_writes",
    "steps",
    "blockers",
    "warnings"
  ],
  "properties": {
    "format": {
      "const": "workbench-runtime-plan-v1"
    },
    "schema_version": {
      "const": 1
    },
    "plan_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "operation_class": {
      "const": "read-only"
    },
    "state": {
      "enum": [
        "ready",
        "blocked"
      ]
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "side",
        "launcher"
      ],
      "properties": {
        "side": {
          "enum": [
            "client",
            "server"
          ]
        },
        "launcher": {
          "enum": [
            "prism",
            "multimc",
            "dedicated-server"
          ]
        }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_uri",
        "revision",
        "dirty"
      ],
      "properties": {
        "root_uri": {
          "type": "string",
          "format": "uri"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$"
        },
        "dirty": {
          "type": "boolean"
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "manifest_sha256",
        "minecraft_version",
        "loaders",
        "index"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "minecraft_version": {
          "type": "string",
          "minLength": 1
        },
        "loaders": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/loader"
          }
        },
        "index": {
          "$ref": "#/$defs/index"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_root_uri",
        "platform_profile_id",
        "cleanroom_version",
        "runtime_java",
        "pack_profile_id",
        "selected_pack_profile"
      ],
      "properties": {
        "fixture_root_uri": {
          "type": "string",
          "format": "uri"
        },
        "platform_profile_id": {
          "type": "string",
          "minLength": 1
        },
        "cleanroom_version": {
          "type": "string",
          "minLength": 1
        },
        "runtime_java": {
          "type": "string",
          "minLength": 1
        },
        "pack_profile_id": {
          "type": "string",
          "minLength": 1
        },
        "selected_pack_profile": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "intended_writes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "root_uri",
          "purpose"
        ],
        "properties": {
          "root_uri": {
            "type": "string",
            "format": "uri"
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "summary"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/blocker"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "loader": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "index": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "hash_format",
        "declared_hash",
        "actual_sha256",
        "matches_declared_hash"
      ],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "hash_format": {
          "const": "sha256"
        },
        "declared_hash": {
          "$ref": "#/$defs/sha256"
        },
        "actual_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "matches_declared_hash": {
          "type": "boolean"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "url",
        "sha256",
        "state"
      ],
      "properties": {
        "id": {
          "enum": [
            "packwiz_installer",
            "cleanroom_client",
            "cleanroom_server"
          ]
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "resolved",
            "unresolved"
          ]
        }
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "reason",
        "resolution"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "resolution": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
