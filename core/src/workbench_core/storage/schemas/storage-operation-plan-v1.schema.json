{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workbench://schemas/crucible/storage-operation-plan-v1.schema.json",
  "title": "Workbench storage operation plan V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schema_version",
    "canonicalization_id",
    "plan_id",
    "read_only_preview",
    "operation",
    "status",
    "created_at",
    "workspace_root",
    "storage_root",
    "command",
    "parameters",
    "profile",
    "inputs",
    "actions",
    "effects",
    "recovery",
    "blockers",
    "limitations"
  ],
  "properties": {
    "format": {
      "const": "workbench-storage-operation-plan-v1"
    },
    "schema_version": {
      "const": 1
    },
    "canonicalization_id": {
      "const": "workbench-canonical-json-v1"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^workbench-storage-operation-plan:sha256:[0-9a-f]{64}$"
    },
    "read_only_preview": {
      "const": true
    },
    "operation": {
      "$ref": "#/$defs/operation"
    },
    "status": {
      "enum": [
        "ready",
        "blocked"
      ]
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "workspace_root": {
      "$ref": "#/$defs/absolutePath"
    },
    "storage_root": {
      "$ref": "#/$defs/absolutePath"
    },
    "command": {
      "$ref": "#/$defs/singleLine"
    },
    "parameters": {
      "$ref": "#/$defs/parameters"
    },
    "profile": {
      "oneOf": [
        {
          "$ref": "#/$defs/profile"
        },
        {
          "type": "null"
        }
      ]
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/input"
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "effects": {
      "$ref": "#/$defs/effects"
    },
    "recovery": {
      "$ref": "#/$defs/recovery"
    },
    "blockers": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/blocker"
      }
    },
    "limitations": {
      "$ref": "#/$defs/limitations"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ready"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "blockers": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "blockers": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "cleanup",
              "restore-trash",
              "purge-trash"
            ]
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "profile": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "runtime-create",
              "world-snapshot",
              "world-restore"
            ]
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "profile": {
            "$ref": "#/$defs/profile"
          },
          "recovery": {
            "properties": {
              "state": {
                "const": "new-destination-only"
              },
              "confirmation_token": {
                "type": "null"
              }
            },
            "required": [
              "state",
              "confirmation_token"
            ]
          },
          "parameters": {
            "properties": {
              "label": {
                "$ref": "#/$defs/label"
              },
              "confirmation": {
                "type": "null"
              }
            },
            "required": [
              "label",
              "confirmation"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "cleanup"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "recovery": {
            "properties": {
              "state": {
                "const": "restore-trash"
              },
              "confirmation_token": {
                "type": "null"
              }
            },
            "required": [
              "state",
              "confirmation_token"
            ]
          },
          "parameters": {
            "properties": {
              "label": {
                "type": "null"
              },
              "seed": {
                "type": "null"
              },
              "level_name": {
                "type": "null"
              },
              "server_port": {
                "type": "null"
              },
              "confirmation": {
                "type": "null"
              }
            },
            "required": [
              "label",
              "seed",
              "level_name",
              "server_port",
              "confirmation"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "purge-trash"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "recovery": {
            "properties": {
              "state": {
                "const": "irreversible"
              },
              "confirmation_token": {
                "$ref": "#/$defs/identifier"
              }
            },
            "required": [
              "state",
              "confirmation_token"
            ]
          },
          "parameters": {
            "properties": {
              "label": {
                "type": "null"
              },
              "seed": {
                "type": "null"
              },
              "level_name": {
                "type": "null"
              },
              "server_port": {
                "type": "null"
              },
              "allow_review": {
                "const": false
              },
              "confirmation": {
                "$ref": "#/$defs/identifier"
              }
            },
            "required": [
              "label",
              "seed",
              "level_name",
              "server_port",
              "allow_review",
              "confirmation"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "runtime-create"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "parameters": {
            "properties": {
              "label": {
                "$ref": "#/$defs/label"
              },
              "seed": {
                "type": "integer"
              },
              "level_name": {
                "$ref": "#/$defs/levelName"
              },
              "server_port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "allow_review": {
                "const": false
              },
              "confirmation": {
                "type": "null"
              }
            },
            "required": [
              "label",
              "seed",
              "level_name",
              "server_port",
              "allow_review",
              "confirmation"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "world-snapshot"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "parameters": {
            "properties": {
              "seed": {
                "type": "null"
              },
              "level_name": {
                "type": "null"
              },
              "server_port": {
                "type": "null"
              },
              "allow_review": {
                "const": false
              }
            },
            "required": [
              "seed",
              "level_name",
              "server_port",
              "allow_review"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "world-restore"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "parameters": {
            "properties": {
              "seed": {
                "type": "null"
              },
              "level_name": {
                "$ref": "#/$defs/levelName"
              },
              "server_port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "allow_review": {
                "const": false
              }
            },
            "required": [
              "seed",
              "level_name",
              "server_port",
              "allow_review"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "restore-trash"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "recovery": {
            "properties": {
              "state": {
                "const": "not-needed"
              },
              "confirmation_token": {
                "type": "null"
              }
            },
            "required": [
              "state",
              "confirmation_token"
            ]
          },
          "parameters": {
            "properties": {
              "label": {
                "type": "null"
              },
              "seed": {
                "type": "null"
              },
              "level_name": {
                "type": "null"
              },
              "server_port": {
                "type": "null"
              },
              "allow_review": {
                "const": false
              },
              "confirmation": {
                "type": "null"
              }
            },
            "required": [
              "label",
              "seed",
              "level_name",
              "server_port",
              "allow_review",
              "confirmation"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/+@=-]*$"
    },
    "singleLine": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "pattern": "^[^\\r\\n\\u0000]+$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "absolutePath": {
      "allOf": [
        {
          "$ref": "#/$defs/singleLine"
        },
        {
          "not": {
            "pattern": "(^|[\\\\/])\\.\\.([\\\\/]|$)"
          }
        }
      ]
    },
    "workbenchRelativePath": {
      "allOf": [
        {
          "type": "string",
          "minLength": 11,
          "maxLength": 8192,
          "pattern": "^\\.workbench/[^\\r\\n\\u0000]+$"
        },
        {
          "not": {
            "pattern": "(^|/)\\.\\.(/|$)"
          }
        }
      ]
    },
    "nullableAbsolutePath": {
      "oneOf": [
        {
          "$ref": "#/$defs/absolutePath"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableWorkbenchRelativePath": {
      "oneOf": [
        {
          "$ref": "#/$defs/workbenchRelativePath"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableIdentifier": {
      "oneOf": [
        {
          "$ref": "#/$defs/identifier"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableSha256": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "operation": {
      "enum": [
        "runtime-create",
        "world-snapshot",
        "world-restore",
        "cleanup",
        "restore-trash",
        "purge-trash"
      ]
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "levelName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_.-]+$",
      "not": {
        "enum": [".", ".."]
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "seed",
        "level_name",
        "server_port",
        "allow_review",
        "confirmation"
      ],
      "properties": {
        "label": {
          "oneOf": [
            {
              "$ref": "#/$defs/label"
            },
            {
              "type": "null"
            }
          ]
        },
        "seed": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": -9223372036854775808,
              "maximum": 9223372036854775807
            },
            {
              "type": "null"
            }
          ]
        },
        "level_name": {
          "oneOf": [
            {
              "$ref": "#/$defs/levelName"
            },
            {
              "type": "null"
            }
          ]
        },
        "server_port": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            {
              "type": "null"
            }
          ]
        },
        "allow_review": {
          "type": "boolean"
        },
        "confirmation": {
          "oneOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "limitations": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/singleLine"
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pack",
        "profile_id",
        "profile_path",
        "profile_file_sha256",
        "profile_canonical_sha256",
        "platform_profile_id",
        "side"
      ],
      "properties": {
        "pack": {
          "$ref": "#/$defs/identifier"
        },
        "profile_id": {
          "$ref": "#/$defs/identifier"
        },
        "profile_path": {
          "$ref": "#/$defs/absolutePath"
        },
        "profile_file_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "profile_canonical_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "platform_profile_id": {
          "$ref": "#/$defs/identifier"
        },
        "side": {
          "const": "dedicated-server"
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_id",
        "role",
        "item_id",
        "resource_id",
        "path",
        "relative_path",
        "observation_sha256",
        "binding_sha256"
      ],
      "properties": {
        "input_id": {
          "type": "string",
          "pattern": "^workbench-storage-input:sha256:[0-9a-f]{64}$"
        },
        "role": {
          "enum": [
            "profile",
            "runtime-template",
            "managed-runtime",
            "world",
            "world-snapshot",
            "storage-item",
            "trash"
          ]
        },
        "item_id": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^workbench-storage-item:sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "resource_id": {
          "$ref": "#/$defs/nullableIdentifier"
        },
        "path": {
          "$ref": "#/$defs/nullableAbsolutePath"
        },
        "relative_path": {
          "$ref": "#/$defs/nullableWorkbenchRelativePath"
        },
        "observation_sha256": {
          "$ref": "#/$defs/nullableSha256"
        },
        "binding_sha256": {
          "$ref": "#/$defs/nullableSha256"
        }
      },
      "anyOf": [
        {
          "properties": {
            "item_id": {
              "type": "string"
            }
          },
          "required": [
            "item_id"
          ]
        },
        {
          "properties": {
            "resource_id": {
              "type": "string"
            }
          },
          "required": [
            "resource_id"
          ]
        },
        {
          "properties": {
            "path": {
              "type": "string"
            }
          },
          "required": [
            "path"
          ]
        }
      ]
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "resource_id",
        "path",
        "relative_path",
        "observation_sha256"
      ],
      "properties": {
        "item_id": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^workbench-storage-item:sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "resource_id": {
          "$ref": "#/$defs/nullableIdentifier"
        },
        "path": {
          "$ref": "#/$defs/nullableAbsolutePath"
        },
        "relative_path": {
          "$ref": "#/$defs/nullableWorkbenchRelativePath"
        },
        "observation_sha256": {
          "$ref": "#/$defs/nullableSha256"
        }
      },
      "anyOf": [
        {
          "properties": {
            "item_id": {
              "type": "string"
            }
          },
          "required": [
            "item_id"
          ]
        },
        {
          "properties": {
            "resource_id": {
              "type": "string"
            }
          },
          "required": [
            "resource_id"
          ]
        },
        {
          "properties": {
            "path": {
              "type": "string"
            }
          },
          "required": [
            "path"
          ]
        }
      ]
    },
    "nullableEndpoint": {
      "oneOf": [
        {
          "$ref": "#/$defs/endpoint"
        },
        {
          "type": "null"
        }
      ]
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "kind",
        "purpose",
        "source",
        "destination",
        "expected_logical_bytes",
        "recoverable"
      ],
      "properties": {
        "action_id": {
          "type": "string",
          "pattern": "^workbench-storage-action:sha256:[0-9a-f]{64}$"
        },
        "kind": {
          "enum": [
            "audit-source",
            "copy-independent",
            "reserve-fresh-world",
            "write-manifest",
            "move-to-trash",
            "restore-from-trash",
            "purge-trash"
          ]
        },
        "purpose": {
          "$ref": "#/$defs/singleLine"
        },
        "source": {
          "$ref": "#/$defs/nullableEndpoint"
        },
        "destination": {
          "$ref": "#/$defs/nullableEndpoint"
        },
        "expected_logical_bytes": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "recoverable": {
          "type": "boolean"
        }
      }
    },
    "move": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "destination"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/workbenchRelativePath"
        },
        "destination": {
          "$ref": "#/$defs/workbenchRelativePath"
        }
      }
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "creates",
        "moves",
        "removes",
        "retains",
        "expected_reclaimed_bytes"
      ],
      "properties": {
        "creates": {
          "type": "array",
          "maxItems": 10000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/workbenchRelativePath"
          }
        },
        "moves": {
          "type": "array",
          "maxItems": 10000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/move"
          }
        },
        "removes": {
          "type": "array",
          "maxItems": 10000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/workbenchRelativePath"
          }
        },
        "retains": {
          "type": "array",
          "maxItems": 10000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/workbenchRelativePath"
          }
        },
        "expected_reclaimed_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "instruction",
        "confirmation_token"
      ],
      "properties": {
        "state": {
          "enum": [
            "new-destination-only",
            "restore-trash",
            "not-needed",
            "irreversible"
          ]
        },
        "instruction": {
          "$ref": "#/$defs/singleLine"
        },
        "confirmation_token": {
          "$ref": "#/$defs/nullableIdentifier"
        }
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "detail",
        "item_ids"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/identifier"
        },
        "detail": {
          "$ref": "#/$defs/singleLine"
        },
        "item_ids": {
          "type": "array",
          "maxItems": 10000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^workbench-storage-item:sha256:[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
