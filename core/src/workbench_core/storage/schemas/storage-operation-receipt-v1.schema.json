{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workbench://schemas/crucible/storage-operation-receipt-v1.schema.json",
  "title": "Workbench storage operation receipt V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schema_version",
    "canonicalization_id",
    "receipt_id",
    "plan_id",
    "operation",
    "status",
    "started_at",
    "completed_at",
    "workspace_root",
    "storage_root",
    "actions",
    "result",
    "error",
    "limitations"
  ],
  "properties": {
    "format": {
      "const": "workbench-storage-operation-receipt-v1"
    },
    "schema_version": {
      "const": 1
    },
    "canonicalization_id": {
      "const": "workbench-canonical-json-v1"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^workbench-storage-operation-receipt:sha256:[0-9a-f]{64}$"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^workbench-storage-operation-plan:sha256:[0-9a-f]{64}$"
    },
    "operation": {
      "$ref": "#/$defs/operation"
    },
    "status": {
      "enum": [
        "running",
        "complete",
        "failed"
      ]
    },
    "started_at": {
      "$ref": "#/$defs/timestamp"
    },
    "completed_at": {
      "$ref": "#/$defs/nullableTimestamp"
    },
    "workspace_root": {
      "$ref": "#/$defs/absolutePath"
    },
    "storage_root": {
      "$ref": "#/$defs/absolutePath"
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "result": {
      "$ref": "#/$defs/result"
    },
    "error": {
      "oneOf": [
        {
          "$ref": "#/$defs/error"
        },
        {
          "type": "null"
        }
      ]
    },
    "limitations": {
      "$ref": "#/$defs/limitations"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "running"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "completed_at": {
            "type": "null"
          },
          "error": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "complete"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "completed_at": {
            "$ref": "#/$defs/timestamp"
          },
          "error": {
            "type": "null"
          },
          "actions": {
            "items": {
              "allOf": [
                {
                  "$ref": "#/$defs/action"
                },
                {
                  "properties": {
                    "status": {
                      "const": "complete"
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "completed_at": {
            "$ref": "#/$defs/timestamp"
          },
          "error": {
            "$ref": "#/$defs/error"
          },
          "actions": {
            "contains": {
              "properties": {
                "status": {
                  "const": "failed"
                }
              },
              "required": [
                "status"
              ]
            },
            "minContains": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/+@=-]*$"
    },
    "singleLine": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "pattern": "^[^\\r\\n\\u0000]+$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "nullableTimestamp": {
      "oneOf": [
        {
          "$ref": "#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "absolutePath": {
      "allOf": [
        {
          "$ref": "#/$defs/singleLine"
        },
        {
          "not": {
            "pattern": "(^|[\\\\/])\\.\\.([\\\\/]|$)"
          }
        }
      ]
    },
    "workbenchRelativePath": {
      "allOf": [
        {
          "type": "string",
          "minLength": 11,
          "maxLength": 8192,
          "pattern": "^\\.workbench/[^\\r\\n\\u0000]+$"
        },
        {
          "not": {
            "pattern": "(^|/)\\.\\.(/|$)"
          }
        }
      ]
    },
    "nullableWorkbenchRelativePath": {
      "oneOf": [
        {
          "$ref": "#/$defs/workbenchRelativePath"
        },
        {
          "type": "null"
        }
      ]
    },
    "operation": {
      "enum": [
        "runtime-create",
        "world-snapshot",
        "world-restore",
        "cleanup",
        "restore-trash",
        "purge-trash"
      ]
    },
    "actionKind": {
      "enum": [
        "audit-source",
        "copy-independent",
        "reserve-fresh-world",
        "write-manifest",
        "move-to-trash",
        "restore-from-trash",
        "purge-trash"
      ]
    },
    "limitations": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/singleLine"
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "kind",
        "status",
        "started_at",
        "completed_at",
        "source_relative_path",
        "destination_relative_path",
        "bytes_processed",
        "error"
      ],
      "properties": {
        "action_id": {
          "type": "string",
          "pattern": "^workbench-storage-action:sha256:[0-9a-f]{64}$"
        },
        "kind": {
          "$ref": "#/$defs/actionKind"
        },
        "status": {
          "enum": [
            "pending",
            "running",
            "complete",
            "failed"
          ]
        },
        "started_at": {
          "$ref": "#/$defs/nullableTimestamp"
        },
        "completed_at": {
          "$ref": "#/$defs/nullableTimestamp"
        },
        "source_relative_path": {
          "$ref": "#/$defs/nullableWorkbenchRelativePath"
        },
        "destination_relative_path": {
          "$ref": "#/$defs/nullableWorkbenchRelativePath"
        },
        "bytes_processed": {
          "type": "integer",
          "minimum": 0
        },
        "error": {
          "oneOf": [
            {
              "$ref": "#/$defs/singleLine"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "pending"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "started_at": {
                "type": "null"
              },
              "completed_at": {
                "type": "null"
              },
              "error": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "running"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "started_at": {
                "$ref": "#/$defs/timestamp"
              },
              "completed_at": {
                "type": "null"
              },
              "error": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "complete"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "started_at": {
                "$ref": "#/$defs/timestamp"
              },
              "completed_at": {
                "$ref": "#/$defs/timestamp"
              },
              "error": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "failed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "started_at": {
                "$ref": "#/$defs/timestamp"
              },
              "completed_at": {
                "$ref": "#/$defs/timestamp"
              },
              "error": {
                "$ref": "#/$defs/singleLine"
              }
            }
          }
        }
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_ids",
        "trash_id",
        "restored_item_id",
        "purged_bytes",
        "output_paths"
      ],
      "properties": {
        "resource_ids": {
          "type": "array",
          "maxItems": 10000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "trash_id": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^workbench-storage-trash:sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "restored_item_id": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^workbench-storage-item:sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "purged_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "output_paths": {
          "type": "array",
          "maxItems": 10000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/workbenchRelativePath"
          }
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "message",
        "action_id"
      ],
      "properties": {
        "type": {
          "$ref": "#/$defs/identifier"
        },
        "message": {
          "$ref": "#/$defs/singleLine"
        },
        "action_id": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^workbench-storage-action:sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
