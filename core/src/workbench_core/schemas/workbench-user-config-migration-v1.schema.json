{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workbench.invalid/schemas/workbench-user-config-migration-v1.schema.json",
  "title": "Workbench User Configuration Migration V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schema_version", "source", "destination", "files", "state"],
  "properties": {
    "format": {"const": "workbench-user-config-migration-v1"},
    "schema_version": {"const": 1},
    "source": {"type": "string", "minLength": 1},
    "destination": {"type": "string", "minLength": 1},
    "files": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sha256", "state"],
        "properties": {
          "name": {"enum": ["setup-v1.json", "recipe-fixtures-v1.json", "launcher-v1.json"]},
          "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "state": {"enum": ["copy", "already-present", "conflict", "copied"]}
        }
      }
    },
    "state": {"enum": ["explicit-config-home", "conflict", "ready", "nothing-to-import", "imported"]}
  }
}
