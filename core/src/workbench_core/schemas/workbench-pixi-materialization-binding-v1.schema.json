{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workbench://schemas/workbench-shell/workbench-pixi-materialization-binding-v1.schema.json",
  "title": "Workbench exact Pixi materialization binding V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schema_version",
    "binding_id",
    "manifest",
    "lock",
    "closure"
  ],
  "properties": {
    "format": {"const": "workbench-pixi-materialization-binding-v1"},
    "schema_version": {"const": 1},
    "binding_id": {
      "type": "string",
      "pattern": "^workbench-pixi-materialization-binding-v1:sha256:[0-9a-f]{64}$"
    },
    "manifest": {"$ref": "#/$defs/manifest"},
    "lock": {"$ref": "#/$defs/input"},
    "closure": {"$ref": "workbench-pixi-environment-closure-v1.schema.json"}
  },
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "requires_pixi"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "requires_pixi": {
          "type": "string",
          "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}(?:[-+][0-9A-Za-z.-]+)?$"
        }
      }
    }
  }
}
