{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schema_version",
    "id",
    "attempt_id",
    "request_id",
    "result_id",
    "producer",
    "bindings",
    "scope_id",
    "native_outcome",
    "coverage",
    "source_result",
    "retained_inputs",
    "sections"
  ],
  "properties": {
    "format": {
      "const": "workbench-check-snapshot-v1"
    },
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^check-snapshot:sha256:[0-9a-f]{64}$"
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "result_id": {
      "type": "string",
      "minLength": 1
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "build_sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.:-]*$"
        },
        "build_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "configuration",
        "context",
        "engine",
        "runtime",
        "jvm"
      ],
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "configuration": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "context": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "engine": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "runtime": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "jvm": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "scope_id": {
      "type": "string",
      "pattern": "^check-snapshot-scope:sha256:[0-9a-f]{64}$"
    },
    "native_outcome": {
      "enum": [
        "completed",
        "native-failed",
        "incomplete"
      ]
    },
    "coverage": {
      "enum": [
        "complete",
        "incomplete"
      ]
    },
    "source_result": {
      "$ref": "#/$defs/blob"
    },
    "retained_inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.:-]*$"
          },
          "content": {
            "$ref": "#/$defs/blob"
          }
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/section"
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workbench://schemas/workbench-core/workbench-check-snapshot-v1.schema.json",
  "title": "Workbench retained check snapshot V1",
  "$defs": {
    "blob": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "bytes",
        "media_type"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "schema",
        "required",
        "state",
        "count",
        "content",
        "dependencies",
        "reason"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.:-]*$"
        },
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "state": {
          "enum": [
            "observed",
            "incomplete",
            "unavailable",
            "not-applicable"
          ]
        },
        "count": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "content": {
          "anyOf": [
            {
              "$ref": "#/$defs/blob"
            },
            {
              "type": "null"
            }
          ]
        },
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.:-]*$"
          }
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
