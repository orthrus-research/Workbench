{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workbench://schemas/workbench-shell/workbench-pixi-environment-closure-v1.schema.json",
  "title": "Workbench target-scoped Pixi environment closure V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schema_version",
    "closure_id",
    "environment",
    "lock_version",
    "platform",
    "channels",
    "indexes",
    "packages"
  ],
  "properties": {
    "format": {"const": "workbench-pixi-environment-closure-v1"},
    "schema_version": {"const": 1},
    "closure_id": {
      "type": "string",
      "pattern": "^workbench-pixi-environment-closure-v1:sha256:[0-9a-f]{64}$"
    },
    "environment": {"type": "string", "minLength": 1},
    "lock_version": {"type": "integer", "minimum": 1},
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "subdir", "lock_key", "virtual_packages"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "subdir": {"type": "string", "minLength": 1},
        "lock_key": {"type": "string", "minLength": 1},
        "virtual_packages": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "channels": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "indexes": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/package"}
    }
  },
  "$defs": {
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ecosystem",
        "name",
        "version",
        "location",
        "sha256",
        "size",
        "occurrences",
        "declared_license",
        "purls"
      ],
      "properties": {
        "ecosystem": {"enum": ["conda", "pypi"]},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "location": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size": {
          "oneOf": [
            {"type": "integer", "minimum": 1},
            {"type": "null"}
          ]
        },
        "occurrences": {"type": "integer", "minimum": 1},
        "declared_license": {
          "oneOf": [
            {"type": "string"},
            {"type": "null"}
          ]
        },
        "purls": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        }
      }
    }
  }
}
