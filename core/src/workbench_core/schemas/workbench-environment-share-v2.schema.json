{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workbench environment share V2 with a selected project source lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schema_version", "intent", "lock", "share_id"],
  "properties": {
    "format": {"const": "workbench-environment-share-v2"},
    "schema_version": {"const": 2},
    "share_id": {"$ref": "#/$defs/shareId"},
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "schema_version", "selection", "java", "intent_id"],
      "properties": {
        "format": {"const": "workbench-environment-intent-v1"},
        "schema_version": {"const": 1},
        "intent_id": {"$ref": "#/$defs/intentId"},
        "selection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["configuration_schema", "pack_document", "pack_variant", "platform_document"],
          "properties": {
            "configuration_schema": {"const": "workbench/config/v1"},
            "pack_document": {"$ref": "#/$defs/profilePath"},
            "pack_variant": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
            "platform_document": {"$ref": "#/$defs/profilePath"}
          }
        },
        "java": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "feature_version"],
          "properties": {
            "mode": {"enum": ["profile-default", "managed-feature", "local-binding-required"]},
            "feature_version": {"type": ["integer", "null"], "enum": [null, 8]}
          }
        }
      }
    },
    "lock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format", "schema_version", "intent_id", "selection_digest", "pack_profile",
        "platform_profile", "java_policy", "host_variant", "unresolved_inputs", "project_source_lock", "lock_id"
      ],
      "properties": {
        "format": {"const": "workbench-environment-lock-v2"},
        "schema_version": {"const": 2},
        "intent_id": {"$ref": "#/$defs/intentId"},
        "lock_id": {"$ref": "#/$defs/lockId"},
        "selection_digest": {"$ref": "#/$defs/digest"},
        "pack_profile": {"$ref": "#/$defs/profileLock"},
        "platform_profile": {"$ref": "#/$defs/profileLock"},
        "project_source_lock": {
          "type": "object",
          "additionalProperties": false,
          "required": ["relative_path", "sha256", "repository", "revision", "tree"],
          "properties": {
            "relative_path": {"type": "string", "pattern": "^profiles/.+\\.json$"},
            "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "repository": {"type": "string", "pattern": "^https://.+\\.git$"},
            "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
          }
        },
        "java_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile_policy_sha256", "selected_policy_sha256", "feature_version",
            "runtime_identity", "release_name"
          ],
          "properties": {
            "profile_policy_sha256": {"$ref": "#/$defs/digest"},
            "selected_policy_sha256": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
            "feature_version": {"type": ["integer", "null"]},
            "runtime_identity": {"type": ["string", "null"]},
            "release_name": {"type": ["string", "null"]}
          }
        },
        "host_variant": {
          "type": "object",
          "additionalProperties": false,
          "required": ["os", "architecture"],
          "properties": {
            "os": {"enum": ["linux", "windows", "mac"]},
            "architecture": {"enum": ["x64", "aarch64", "ppc64le", "s390x", "riscv64"]}
          }
        },
        "unresolved_inputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}
        }
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^(sha256:)?[0-9a-f]{64}$"},
    "shareId": {"type": "string", "pattern": "^workbench-environment-share:sha256:[0-9a-f]{64}$"},
    "intentId": {"type": "string", "pattern": "^workbench-environment-intent:sha256:[0-9a-f]{64}$"},
    "lockId": {"type": "string", "pattern": "^workbench-environment-lock:sha256:[0-9a-f]{64}$"},
    "profilePath": {"type": "string", "pattern": "^profiles/.+\\.ya?ml$"},
    "profileLock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "sha256"],
      "properties": {
        "profile_id": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
