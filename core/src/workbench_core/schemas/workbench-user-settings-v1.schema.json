{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workbench.invalid/schemas/workbench-user-settings-v1.schema.json",
  "title": "Workbench User Settings V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schema_version", "locations", "record_id"],
  "properties": {
    "format": {"const": "workbench-user-settings-v1"},
    "schema_version": {"const": 1},
    "record_id": {"type": "string", "pattern": "^workbench-user-settings:sha256:[0-9a-f]{64}$"},
    "locations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workspace_parent": {"$ref": "#/$defs/location"},
        "artifacts": {"$ref": "#/$defs/location"},
        "logs": {"$ref": "#/$defs/location"},
        "blueprint_library": {"$ref": "#/$defs/location"},
        "blueprint_sessions": {"$ref": "#/$defs/location"},
        "fixture_library": {"$ref": "#/$defs/location"},
        "fixture_instances": {"$ref": "#/$defs/location"},
        "cache": {"$ref": "#/$defs/location"},
        "evidence": {"$ref": "#/$defs/location"}
      }
    }
  },
  "$defs": {
    "location": {"type": "string", "minLength": 1}
  }
}
