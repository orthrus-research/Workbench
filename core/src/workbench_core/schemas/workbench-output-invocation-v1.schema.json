{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workbench.invalid/schemas/workbench-output-invocation-v1.schema.json",
  "title": "Workbench Output Invocation V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format", "schema_version", "record_id", "invocation_id", "module_id",
    "capability_id", "started_at", "finished_at", "outcome", "exit_code",
    "error_type", "error_message", "streams", "outputs"
  ],
  "properties": {
    "format": {"const": "workbench-output-invocation-v1"},
    "schema_version": {"const": 1},
    "record_id": {"type": "string", "pattern": "^workbench-output-invocation:sha256:[0-9a-f]{64}$"},
    "invocation_id": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{12}Z-[0-9a-f]{12}$"},
    "module_id": {"$ref": "#/$defs/identifier"},
    "capability_id": {"$ref": "#/$defs/identifier"},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "outcome": {"enum": ["completed", "failed", "interrupted"]},
    "exit_code": {"type": ["integer", "null"]},
    "error_type": {"type": ["string", "null"]},
    "error_message": {"type": ["string", "null"]},
    "streams": {
      "type": "object", "additionalProperties": false,
      "required": ["stdout", "stderr"],
      "properties": {
        "stdout": {"$ref": "#/$defs/stream"},
        "stderr": {"$ref": "#/$defs/stream"}
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["role", "name", "path", "file"],
        "properties": {
          "role": {"enum": ["logs", "artifacts", "evidence", "cache", "blueprint_sessions", "fixture_instances"]},
          "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
          "path": {"type": "string", "minLength": 1},
          "file": {"anyOf": [{"$ref": "#/$defs/file"}, {"type": "null"}]}
        }
      }
    }
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"},
    "file": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "stream": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "bytes", "sha256", "omitted_bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "omitted_bytes": {"type": "integer", "minimum": 0}
      }
    }
  }
}
