$description: #D7BC72;
$metadata: #70C8C0;

Screen {
    background: $background;
    color: $foreground;
}

Header {
    background: $background;
    color: $primary;
    height: 3;
    border-bottom: solid $secondary;
}

/* Two text rows and a rule use the same space as the former separate heading. */
Header HeaderIcon {
    width: 3;
    padding: 0 1;
    color: $metadata;
    content-align: left top;
}

Header HeaderTitle {
    height: 2;
    padding: 0 1;
    content-align: left top;
    text-wrap: nowrap;
}

Header HeaderClock {
    content-align: center top;
}

.screen-heading {
    display: none;
}

Footer {
    background: $background;
}

Screen.-narrow FooterKey.-command-palette {
    display: none;
}

/* Keep controls on the terminal grid.  Focus uses inverse video, as a DOS
   menu would, while the amber and teal text distinguish actions from data. */
Button {
    width: auto;
    min-width: 0;
    height: 1;
    min-height: 1;
    padding: 0 1;
    border: none !important;
    background: $background !important;
    color: $metadata !important;
    text-style: bold;
}

Button.-primary, Button.-warning, Button.-success {
    color: $description !important;
}

Button:hover {
    background: $panel !important;
    color: $description !important;
}

Button:focus, Button.keyboard-selected, Button.-active {
    background: $metadata !important;
    color: $background !important;
}

Button:disabled {
    background: $background !important;
    color: $foreground-muted !important;
    text-opacity: 1 !important;
    text-style: none;
}

Input {
    height: 1;
    min-height: 1;
    padding: 0 1;
    border: none !important;
    background: $background;
    color: $foreground;
}

Input:focus, Input.keyboard-editing {
    background: $panel;
    color: $description;
    background-tint: transparent;
}

Input.keyboard-selected {
    background: $panel;
    color: $metadata;
}

Input > .input--placeholder, Input > .input--suggestion {
    color: $foreground-muted;
}

OptionList {
    background: $background;
    border: solid $secondary;
    padding: 0 1;
}

OptionList:focus {
    border: solid $metadata;
    background-tint: transparent;
}

OptionList > .option-list--option-highlighted,
OptionList:focus > .option-list--option-highlighted {
    background: $metadata;
    color: $background;
    text-style: bold;
}

OptionList > .option-list--option-hover {
    background: $panel;
}

DataTable {
    background: $background;
}

DataTable:focus {
    background-tint: transparent;
}

DataTable:focus > .datatable--cursor {
    background: $metadata;
    color: $background;
}

Select > SelectCurrent,
Select:focus > SelectCurrent {
    border: none !important;
    background: $background;
    padding: 0 1;
}

Select:focus > SelectCurrent {
    background: $panel;
    background-tint: transparent;
}

Select.keyboard-selected > SelectCurrent {
    background: $metadata;
    color: $background;
}

Select.keyboard-selected > SelectCurrent Static#label,
Select.keyboard-selected > SelectCurrent .arrow {
    color: $background;
}

Select > SelectOverlay {
    background: $background;
    border: solid $metadata;
}

Checkbox {
    background: $background;
    border: none !important;
}

#home-scroll {
    padding: 0 2;
}

#home-welcome {
    height: auto;
    min-height: 3;
    padding: 0 1;
    background: $background;
    border-bottom: solid $secondary;
}

Screen.narrow-brand #home-panels {
    layout: vertical;
    height: auto;
}

Screen.narrow-brand #home-scroll {
    padding: 0;
}

Screen.narrow-brand #environment-panel,
Screen.narrow-brand #actions-panel {
    width: 100%;
    margin-right: 0;
    margin-bottom: 1;
}

#home-title {
    height: 1;
    color: $primary;
    text-style: bold;
}

#home-subtitle {
    height: auto;
    color: $description;
}

#home-panels {
    height: auto;
    margin-top: 0;
}

#environment-panel {
    width: 2fr;
    height: auto;
    min-height: 14;
    background: $background;
    border: solid $secondary;
    padding: 0 1;
}

#actions-panel {
    width: 3fr;
    height: auto;
    min-height: 14;
    background: $background;
    border: solid $secondary;
    padding: 0 1;
    margin-right: 1;
}

.panel-title {
    height: 1;
    color: $primary;
    text-style: bold;
}

#home-keyboard-hint {
    height: 1;
    color: $metadata;
}

#environment-summary,
#environment-dependencies {
    height: auto;
}

#home-actions {
    height: auto;
    min-height: 9;
    border: none;
    background: $background;
}

#home-note {
    height: auto;
    min-height: 1;
    padding: 0 2;
    color: $foreground-muted;
}

.screen-heading {
    height: 2;
    padding: 0 1;
    color: $primary;
    background: $background;
    border-bottom: solid $secondary;
    text-style: bold;
}

.screen-intro {
    height: auto;
    min-height: 1;
    padding: 0 1 1 1;
    color: $description;
}

.field-label {
    height: 1;
    margin-top: 1;
    color: $foreground;
    text-style: bold;
}

.keyboard-hint {
    height: auto;
    color: $metadata;
    padding: 0 1;
}

.keyboard-selected {
    outline: none;
}

.keyboard-editing {
    outline: none;
}

#keyboard-choice-list {
    height: auto;
    max-height: 14;
    margin: 1 2;
    border: solid $primary;
}

#setup-scroll {
    padding: 0 2 1 2;
}

#setup-scroll Input,
#setup-scroll Select {
    width: 100%;
}

.path-row {
    height: auto;
}

#setup-scroll .path-row Input {
    width: 1fr;
}

.path-row Button {
    margin-left: 1;
}

.instance-path-row {
    height: auto;
}

.instance-path-row Input {
    width: 1fr;
}

.instance-path-row Button {
    margin-left: 1;
}

#pack-source-note,
#pack-java-note {
    height: auto;
    color: $description;
    padding: 0 1;
}

#choice-java-hint {
    color: $description;
}

.-light-mode #home-subtitle,
.-light-mode .screen-intro,
.-light-mode #pack-source-note,
.-light-mode #pack-java-note,
.-light-mode #choice-java-hint {
    color: #785B21;
}

.-light-mode #home-keyboard-hint,
.-light-mode .keyboard-hint {
    color: #006C66;
}

#pack-scroll {
    height: 1fr;
    padding: 0 1;
}

#pack-action-panel {
    height: auto;
    background: $background;
    border-top: solid $secondary;
    padding: 0 1;
}

#pack-action-panel .button-row {
    height: auto;
    margin: 0;
}

#pack-instance-status {
    height: auto;
    max-height: 4;
    overflow-y: auto;
    color: $foreground;
}

.button-row {
    height: auto;
    margin-top: 1;
    margin-bottom: 1;
}

.button-row Button {
    margin-right: 2;
}

#setup-status {
    height: auto;
    min-height: 2;
    padding: 0 1;
}

#setup-dependencies {
    height: 9;
    border: solid $secondary;
}

#setup-plan-detail {
    height: auto;
    min-height: 4;
    padding: 1 2;
    background: $background;
    border: solid $secondary;
}

#inventory-tabs {
    height: 1fr;
    margin: 0 2;
}

.inventory-layout {
    height: 1fr;
}

.inventory-layout DataTable {
    width: 2fr;
    margin-right: 1;
    border: solid $secondary;
}

.inventory-detail-panel {
    width: 1fr;
    background: $background;
    border-left: solid $secondary;
    padding: 1;
    overflow-x: hidden;
}

#workflow-search {
    margin: 0 2 1 2;
}

#workflow-body {
    height: 1fr;
    margin: 0 2;
}

#workflow-list {
    width: 3fr;
    border: solid $secondary;
    margin-right: 1;
}

#workflow-detail-panel {
    width: 2fr;
    background: $background;
    border-left: solid $secondary;
    padding: 0 1;
}

#workflow-detail {
    height: 1fr;
    overflow-y: auto;
}

#workflow-brief {
    display: none;
}

AtlasSearchScreen #atlas-search-detail,
AtlasObservationSearchScreen #atlas-observation-detail {
    height: 1fr;
    overflow-y: auto;
}

#result-log {
    height: 1fr;
    border: solid $secondary;
    margin: 1 2;
    padding: 1;
    background: $background;
    overflow-x: hidden;
}

#axiom-journey-body {
    padding: 0 2 1 2;
}

#axiom-journey-body .field-label {
    margin-top: 0;
}

#axiom-journey-body .button-row {
    margin-top: 0;
    margin-bottom: 0;
}

.axiom-path-row {
    height: 1;
}

.axiom-path-row .field-label {
    width: auto;
    height: 1;
    margin: 0;
    color: $description;
}

.axiom-path-row .inline-prompt {
    width: auto;
    height: 1;
    color: $description;
    text-style: bold;
}

.axiom-path-row Input {
    width: 1fr;
}

.axiom-path-row Button {
    width: 12;
    margin-left: 1;
}

AtlasObservationSearchScreen #atlas-observation-query {
    width: 1fr;
    min-width: 0;
}

AtlasObservationSearchScreen #atlas-observation-search {
    width: auto;
    margin-left: 1;
}

#axiom-guide {
    height: auto;
    color: $description;
    margin: 0;
}

#axiom-status,
#axiom-history-status {
    height: auto;
    min-height: 2;
    color: $metadata;
}

#axiom-history-list {
    height: 1fr;
    margin: 0 1;
    border: solid $secondary;
}

#atlas-search-detail {
    height: 1fr;
    overflow-y: auto;
}

ReviewModal, ReleaseUpdateModal, InstancePathPicker, CatalogInputsScreen, CatalogValueScreen {
    align: center middle;
    background: $background 65%;
}

#review-dialog {
    width: 76;
    max-width: 95%;
    height: 75%;
    background: $background;
    border: double $warning;
    padding: 1 2;
}

#review-heading {
    height: 2;
    color: $warning;
    text-style: bold;
}

#review-scroll {
    height: 1fr;
}

ReviewModal #review-dialog {
    height: auto;
    max-height: 90%;
}

ReviewModal #review-scroll {
    height: auto;
    max-height: 12;
    overflow-y: auto;
}

#review-body {
    height: auto;
}

#catalog-inputs-intro,
#catalog-inputs-error,
#catalog-value-error {
    height: auto;
    margin-bottom: 1;
}

#catalog-fields,
#catalog-value-choices {
    height: 1fr;
    border: solid $secondary;
}

#catalog-value-input {
    margin: 1 0;
}

#instance-path-dialog {
    width: 86;
    max-width: 96%;
    height: 86%;
    background: $background;
    border: solid $secondary;
    padding: 1 2;
}

#instance-path-heading {
    height: 2;
    text-style: bold;
}

#instance-path-hint,
#instance-path-status {
    height: auto;
    min-height: 2;
}

#instance-path-hint-narrow {
    display: none;
}

#instance-path-tree {
    height: 1fr;
    border: solid $secondary;
}

#instance-path-location {
    width: 100%;
}

InstancePathPicker.-narrow #instance-path-dialog {
    height: 96%;
    padding: 0 1;
}

InstancePathPicker.-narrow #instance-path-heading,
InstancePathPicker.-narrow #instance-path-status {
    height: 1;
    min-height: 1;
}

InstancePathPicker.-narrow #instance-path-hint {
    display: none;
}

InstancePathPicker.-narrow #instance-path-hint-narrow {
    display: block;
    height: 1;
}

/* A compact terminal needs the controls and their detail views in one column. */
Screen.-narrow .screen-heading {
    height: 2;
    padding: 0 1;
}

Screen.-narrow .screen-intro {
    display: none;
}

Screen.-narrow .button-row {
    margin-top: 0;
    margin-bottom: 0;
}

Screen.-narrow #setup-scroll {
    padding: 0 1 1 1;
}

Screen.-narrow #setup-scroll .field-label {
    margin-top: 0;
}

Screen.-narrow #setup-scroll .button-row {
    layout: vertical;
}

Screen.-narrow #setup-scroll .button-row Button {
    width: 100%;
    margin-left: 0;
    margin-right: 0;
}

Screen.-narrow .instance-path-row {
    layout: horizontal;
}

Screen.-narrow .instance-path-row Input {
    width: 1fr;
}

Screen.-narrow .instance-path-row Button {
    width: 16;
    margin-left: 1;
    margin-right: 0;
}

Screen.-narrow #setup-scroll .path-row {
    layout: horizontal;
}

Screen.-narrow #setup-scroll .path-row Input {
    width: 1fr;
}

Screen.-narrow #setup-scroll .path-row Button {
    width: 12;
    margin-left: 1;
    margin-right: 0;
}

Screen.-narrow #axiom-journey-body {
    padding: 0 1;
}

Screen.-narrow #axiom-journey-body .field-label {
    margin-top: 0;
}

Screen.-narrow #axiom-journey-body #axiom-guide {
    max-height: 3;
    overflow-y: auto;
}

Screen.-narrow #axiom-journey-body #axiom-status {
    min-height: 1;
}

Screen.-narrow #axiom-journey-body .button-row {
    height: 1;
}

Screen.-narrow #axiom-journey-body .button-row Button {
    width: 1fr;
    min-width: 0;
    height: 1;
    min-height: 1;
    border: none;
    margin-right: 1;
}

AtlasSearchScreen.-narrow #atlas-search-context {
    display: block;
    height: 2;
    min-height: 2;
    overflow-y: auto;
    padding-bottom: 0;
}

AtlasObservationSearchScreen.-narrow #atlas-observation-scope {
    display: block;
    height: 2;
    min-height: 2;
    overflow-y: auto;
    padding-bottom: 0;
}

Screen.-narrow #inventory-tabs {
    margin: 0 1;
}

Screen.-narrow .inventory-layout,
Screen.-narrow #workflow-body {
    layout: vertical;
}

Screen.-narrow .inventory-layout DataTable,
Screen.-narrow .inventory-detail-panel,
Screen.-narrow #workflow-list,
Screen.-narrow #workflow-detail-panel {
    width: 100%;
    height: 1fr;
    margin-right: 0;
}

Screen.-narrow .inventory-layout DataTable,
Screen.-narrow #workflow-list {
    min-height: 4;
}

Screen.-narrow .inventory-detail-panel,
Screen.-narrow #workflow-detail-panel {
    height: 50%;
    min-height: 5;
    max-height: 8;
    padding: 0 1;
    border-left: none;
    border-top: solid $secondary;
}

Screen.-narrow #workflow-detail-panel {
    padding-bottom: 1;
}

Screen.-narrow #workflow-detail {
    display: none;
}

Screen.-narrow #workflow-brief {
    display: block;
    height: 1fr;
    overflow-y: auto;
}

Screen.-narrow #workflow-search {
    margin: 0 1;
}

Screen.-narrow #result-log {
    margin: 0 1;
    padding: 0 1;
}

Screen.-narrow #workflow-body {
    margin: 0 1;
}

Screen.-narrow #workflow-detail-panel .button-row {
    height: 1;
    margin: 0;
}

Screen.-narrow #workflow-detail-panel .button-row Button {
    width: auto;
    min-width: 0;
    height: 1;
    min-height: 1;
    border: none;
    margin-right: 2;
}

#workflow-detail-panel #workflow-back {
    margin-left: 3 !important;
}

AtlasObservationSearchScreen.-narrow #workflow-body {
    height: 1fr;
}

AtlasSearchScreen.-narrow #workflow-body {
    height: 1fr;
}

AtlasSearchScreen.-narrow #atlas-search-results {
    width: 100%;
    height: 1fr;
    min-height: 3;
}

AtlasSearchScreen.-narrow #workflow-detail-panel {
    width: 100%;
    height: 6;
    min-height: 6;
    max-height: 6;
    border: none;
    border-top: solid $secondary;
    padding: 0 1;
}

AtlasSearchScreen.-narrow #atlas-search-detail {
    height: 3;
    overflow-y: auto;
}

AtlasObservationSearchScreen.-narrow #atlas-observation-results {
    width: 100%;
    height: 1fr;
    min-height: 3;
}

AtlasObservationSearchScreen.-narrow #workflow-detail-panel {
    width: 100%;
    height: 5;
    min-height: 5;
    max-height: 5;
    border: none;
    border-top: solid $secondary;
    padding: 0 1;
}

AtlasObservationSearchScreen.-narrow #atlas-observation-detail {
    height: 2;
    overflow-y: hidden;
}

AtlasObservationSearchScreen.-narrow #atlas-observation-back {
    height: 1;
    min-height: 1;
    border: none;
}

ReviewModal.-narrow #review-dialog, ReleaseUpdateModal.-narrow #review-dialog,
CatalogInputsScreen.-narrow #review-dialog, CatalogValueScreen.-narrow #review-dialog {
    width: 95%;
    height: 90%;
    padding: 0 1;
}

ReviewModal.-narrow #review-dialog {
    height: auto;
    max-height: 90%;
}

ReviewModal.-narrow #review-scroll {
    max-height: 8;
}

ReviewModal.-narrow #review-dialog .button-row, ReleaseUpdateModal.-narrow #review-dialog .button-row,
CatalogInputsScreen.-narrow #review-dialog .button-row, CatalogValueScreen.-narrow #review-dialog .button-row {
    layout: vertical;
    margin: 0;
}

ReviewModal.-narrow #review-dialog .button-row Button, ReleaseUpdateModal.-narrow #review-dialog .button-row Button,
CatalogInputsScreen.-narrow #review-dialog .button-row Button,
CatalogValueScreen.-narrow #review-dialog .button-row Button {
    width: 100%;
    margin-right: 0;
}
