{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workbench.local/schemas/workbench-platform-matrix-v1.schema.json",
  "additionalProperties": false,
  "properties": {
    "format": { "const": "workbench-platform-matrix-v1" },
    "pixi": {
      "additionalProperties": false,
      "properties": {
        "checksum_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "checksum_manifest_url": { "$ref": "#/$defs/httpsUrl" },
        "release_commit": { "pattern": "^[0-9a-f]{40}$", "type": "string" },
        "release_tag": { "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$", "type": "string" },
        "release_url": { "$ref": "#/$defs/httpsUrl" },
        "requirement": { "pattern": "^==[0-9]+\\.[0-9]+\\.[0-9]+$", "type": "string" },
        "version": { "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$", "type": "string" }
      },
      "required": [
        "checksum_manifest_sha256",
        "checksum_manifest_url",
        "release_commit",
        "release_tag",
        "release_url",
        "requirement",
        "version"
      ],
      "type": "object"
    },
    "platforms": {
      "items": { "$ref": "#/$defs/platform" },
      "maxItems": 6,
      "minItems": 6,
      "type": "array"
    },
    "schema_version": { "const": 1 }
  },
  "required": ["format", "pixi", "platforms", "schema_version"],
  "type": "object",
  "$defs": {
    "bootstrap": {
      "additionalProperties": false,
      "properties": {
        "archive_format": { "enum": ["tar.gz", "zip"] },
        "archive_sha256": { "$ref": "#/$defs/sha256" },
        "asset": { "pattern": "^[A-Za-z0-9._-]+$", "type": "string" },
        "available": { "const": true },
        "executable": { "enum": ["pixi", "pixi.exe"] },
        "executable_sha256": { "$ref": "#/$defs/sha256" },
        "url": { "$ref": "#/$defs/httpsUrl" }
      },
      "required": [
        "archive_format",
        "archive_sha256",
        "asset",
        "available",
        "executable",
        "executable_sha256",
        "url"
      ],
      "type": "object"
    },
    "httpsUrl": { "pattern": "^https://\\S+$", "type": "string" },
    "implementation": {
      "additionalProperties": false,
      "properties": {
        "compatibility_environment": { "type": "boolean" },
        "source_installer": { "type": "boolean" },
        "workspace_environment": { "type": "boolean" }
      },
      "required": [
        "compatibility_environment",
        "source_installer",
        "workspace_environment"
      ],
      "type": "object"
    },
    "minimumHost": {
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["glibc", "macos", "windows"] },
        "value": { "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}$", "type": "string" }
      },
      "required": ["kind", "value"],
      "type": "object"
    },
    "platform": {
      "additionalProperties": false,
      "properties": {
        "architecture": { "enum": ["arm64", "x86-64"] },
        "bootstrap": { "$ref": "#/$defs/bootstrap" },
        "host_system": { "enum": ["Darwin", "Linux", "Windows"] },
        "implementation": { "$ref": "#/$defs/implementation" },
        "machine_aliases": {
          "items": { "pattern": "^[A-Za-z0-9_-]+$", "type": "string" },
          "minItems": 2,
          "type": "array",
          "uniqueItems": true
        },
        "minimum_host": { "$ref": "#/$defs/minimumHost" },
        "pixi_platform": {
          "enum": [
            "linux-64",
            "linux-aarch64",
            "osx-64",
            "osx-arm64",
            "win-64",
            "win-arm64"
          ]
        },
        "target": {
          "enum": [
            "linux-arm64",
            "linux-x86-64",
            "macos-arm64",
            "macos-x86-64",
            "windows-arm64",
            "windows-x86-64"
          ]
        }
      },
      "required": [
        "architecture",
        "bootstrap",
        "host_system",
        "implementation",
        "machine_aliases",
        "minimum_host",
        "pixi_platform",
        "target"
      ],
      "type": "object"
    },
    "sha256": { "pattern": "^[0-9a-f]{64}$", "type": "string" }
  }
}
