{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Supersymmetry selected release client layout policy V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schema_version", "profile", "input_plan_format", "input_plan_id", "release_id", "version", "asset_sha256", "manifest_sha256", "override_source_root", "destination_root", "override_file_count", "override_total_bytes", "optional_selected", "collision_policy", "installation_state", "runtime_qualification_state"],
  "properties": {
    "format": {"const": "workbench-supersymmetry-release-client-layout-policy-v1"},
    "schema_version": {"const": 1},
    "profile": {"const": "supersymmetry"},
    "input_plan_format": {"const": "workbench-pack-release-input-plan-v1"},
    "input_plan_id": {"type": "string", "pattern": "^workbench-pack-release-input-plan:sha256:[0-9a-f]{64}$"},
    "release_id": {"type": "string", "pattern": "^profile-release:sha256:[0-9a-f]{64}$"},
    "version": {"const": "0.1.16.16"},
    "asset_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "manifest_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "override_source_root": {"const": "overrides/"},
    "destination_root": {"const": "minecraft-root"},
    "override_file_count": {"const": 4168},
    "override_total_bytes": {"const": 122288244},
    "optional_selected": {
      "type": "array", "minItems": 1, "maxItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["project_id", "file_id"],
        "properties": {
          "project_id": {"const": 1214490},
          "file_id": {"const": 8754029}
        }
      }
    },
    "collision_policy": {"const": "reject"},
    "installation_state": {"const": "not-installed"},
    "runtime_qualification_state": {"const": "not-qualified"}
  }
}
