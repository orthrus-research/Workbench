{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cleanroommc.org/workbench/schemas/workbench-supersymmetry-material-fluid-runtime-pair-owner-v1.schema.json",
  "title": "Supersymmetry material-fluid runtime pair owner V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["authority", "cleanup", "comparison", "errors", "executions", "format", "limitations", "outcome", "pair_owner_id", "plan_id", "request", "schema_version", "source_operation_state", "stages", "state"],
  "properties": {
    "format": {"const": "workbench-supersymmetry-material-fluid-runtime-pair-owner-v1"},
    "schema_version": {"const": 1},
    "pair_owner_id": {"pattern": "^workbench-supersymmetry-material-fluid-runtime-pair-owner:sha256:[0-9a-f]{64}$"},
    "plan_id": {"pattern": "^[a-z][a-z0-9-]*:sha256:[0-9a-f]{64}$"},
    "source_operation_state": {"enum": ["before", "after"]},
    "request": {"type": "object"},
    "stages": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"$ref": "#/$defs/stage"}},
    "executions": {"type": "array", "maxItems": 2, "items": {"type": "object"}},
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected", "fingerprints", "observed"],
      "properties": {
        "expected": {"enum": ["stable", "observed-change", "matches-candidate", "matches-baseline"]},
        "observed": {"enum": ["stable", "observed-change", "matches-candidate", "matches-baseline", "mismatch", "unavailable"]},
        "fingerprints": {"type": "array", "maxItems": 2, "items": {"pattern": "^sha256:[0-9a-f]{64}$"}}
      }
    },
    "cleanup": {"type": "object", "additionalProperties": false, "required": ["contained", "owned_processes_running"], "properties": {"contained": {"type": "boolean"}, "owned_processes_running": {"type": "boolean"}}},
    "state": {"enum": ["complete", "failed"]},
    "outcome": {"enum": ["passed", "failed"]},
    "errors": {"type": "array", "items": {"type": "object"}},
    "authority": {"type": "object", "additionalProperties": false, "required": ["claim", "owner", "support_authority"], "properties": {"owner": {"const": "Supersymmetry profile runtime owner"}, "claim": {"const": "exact staged material-fluid client/server pair"}, "support_authority": {"const": "none"}}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "format", "generic_stage", "limitations", "outputs", "plan_id", "revision", "role", "schema_version", "selected_operation_state", "source_operation_state", "source_workspace_uri", "stage_id", "tracked_tree_id", "workspace_uri"],
      "properties": {
        "format": {"const": "workbench-supersymmetry-staged-material-fluid-pack-v1"},
        "schema_version": {"const": 1},
        "stage_id": {"type": "string"},
        "plan_id": {"type": "string"},
        "role": {"enum": ["baseline", "candidate"]},
        "source_operation_state": {"enum": ["before", "after"]},
        "selected_operation_state": {"enum": ["before", "after"]},
        "source_workspace_uri": {"type": "string", "pattern": "^file:"},
        "workspace_uri": {"type": "string", "pattern": "^file:"},
        "revision": {"type": "string"},
        "tracked_tree_id": {"type": "string"},
        "outputs": {"type": "array"},
        "generic_stage": {"type": "object"},
        "authority": {"type": "object"},
        "limitations": {"type": "array", "minItems": 1}
      }
    }
  }
}
