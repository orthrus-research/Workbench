{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cleanroommc.org/workbench/schemas/workbench-supersymmetry-material-fluid-runtime-observation-v1.schema.json",
  "title": "Supersymmetry material-fluid runtime observation V1",
  "$ref": "#/$defs/observation",
  "$defs": {
    "ownerRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner_id", "record_id", "record_kind", "uri", "sha256", "size", "outcome"],
      "properties": {
        "owner_id": {"type": "string", "minLength": 1},
        "record_id": {"type": "string", "minLength": 1},
        "record_kind": {"type": "string", "minLength": 1},
        "uri": {"type": "string", "pattern": "^file:"},
        "sha256": {"pattern": "^sha256:[0-9a-f]{64}$"},
        "size": {"type": "integer", "minimum": 0},
        "outcome": {"enum": ["passed", "failed", "incomplete"]}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assertions", "format", "limitations", "observation_id", "observed", "plan_id", "role", "schema_version", "semantic_fingerprint", "side", "source_refs", "state"],
      "properties": {
        "format": {"const": "workbench-supersymmetry-material-fluid-runtime-observation-v1"},
        "schema_version": {"const": 1},
        "observation_id": {"pattern": "^workbench-supersymmetry-material-fluid-runtime-observation:sha256:[0-9a-f]{64}$"},
        "plan_id": {"pattern": "^[a-z][a-z0-9-]*:sha256:[0-9a-f]{64}$"},
        "role": {"enum": ["baseline", "candidate"]},
        "side": {"enum": ["client", "server"]},
        "state": {"enum": ["observed", "failed", "incomplete"]},
        "semantic_fingerprint": {"pattern": "^sha256:[0-9a-f]{64}$"},
        "assertions": {"type": "object", "minProperties": 6, "maxProperties": 6, "additionalProperties": {"enum": ["observed", "failed", "unavailable"]}},
        "observed": {"type": "object"},
        "source_refs": {"type": "array", "items": {"$ref": "#/$defs/ownerRef"}},
        "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
