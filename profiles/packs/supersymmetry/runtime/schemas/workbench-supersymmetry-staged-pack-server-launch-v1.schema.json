{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cleanroommc.org/workbench/schemas/workbench-supersymmetry-staged-pack-server-launch-v1.schema.json",
  "title": "Supersymmetry staged Packwiz server launch V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["cleanup", "command", "evidence", "failure", "finished_at", "format", "launch_id", "limitations", "materialization_id", "outcome", "plan_id", "readiness", "role", "schema_version", "shutdown", "stage_id", "started_at", "state"],
  "properties": {
    "format": {"const": "workbench-supersymmetry-staged-pack-server-launch-v1"},
    "schema_version": {"const": 1},
    "launch_id": {"pattern": "^workbench-supersymmetry-staged-pack-server-launch:sha256:[0-9a-f]{64}$"},
    "plan_id": {"pattern": "^[a-z][a-z0-9-]*:sha256:[0-9a-f]{64}$"},
    "stage_id": {"type": "string", "minLength": 1},
    "materialization_id": {"type": "string", "minLength": 1},
    "role": {"enum": ["baseline", "candidate"]},
    "started_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "finished_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "state": {"enum": ["complete", "failed"]},
    "outcome": {"enum": ["passed", "failed"]},
    "command": {"type": "array", "minItems": 8, "items": {"type": "string"}},
    "readiness": {"type": "object", "additionalProperties": false, "required": ["cleanroom_ready", "fml_loaded", "pack_ready", "role_marker"], "properties": {"cleanroom_ready": {"type": "boolean"}, "fml_loaded": {"type": "boolean"}, "pack_ready": {"type": "boolean"}, "role_marker": {"type": "boolean"}}},
    "shutdown": {"type": "object", "required": ["acknowledgment", "returncode", "stop_sent"]},
    "cleanup": {"type": "object", "required": ["forced", "pgid", "running"]},
    "failure": {"type": ["string", "null"]},
    "evidence": {"type": "object", "required": ["groovy_log_sha256", "groovy_log_size", "groovy_log_uri", "latest_log_uri", "probe", "stdout_uri"]},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
