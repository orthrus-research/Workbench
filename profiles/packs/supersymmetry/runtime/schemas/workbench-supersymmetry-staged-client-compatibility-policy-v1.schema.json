{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cleanroommc.org/workbench/schemas/workbench-supersymmetry-staged-client-compatibility-policy-v1.schema.json",
  "title": "Supersymmetry staged client compatibility policy V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["components", "format", "identity_patches", "limitations", "mode", "patches", "plan_id", "policy_id", "schema_version", "stage_id", "staged_revision"],
  "properties": {
    "format": {"const": "workbench-supersymmetry-staged-client-compatibility-policy-v1"},
    "schema_version": {"const": 1},
    "policy_id": {"pattern": "^workbench-supersymmetry-staged-client-compatibility-policy:sha256:[0-9a-f]{64}$"},
    "plan_id": {"type": "string", "minLength": 1},
    "stage_id": {"type": "string", "minLength": 1},
    "staged_revision": {"type": "string", "minLength": 1},
    "mode": {"enum": ["exact-native-compatible-pair", "required-exact-profile-patch-set"]},
    "components": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/component"}
    },
    "patches": {"type": "array", "maxItems": 1, "items": {"type": "object"}},
    "identity_patches": {"type": "array", "maxItems": 1, "items": {"type": "object"}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "download_hash", "download_hash_format", "filename", "metadata_path", "metadata_sha256"],
      "properties": {
        "component": {"enum": ["recurrent-complex", "susycore"]},
        "download_hash": {"pattern": "^[0-9a-f]+$"},
        "download_hash_format": {"enum": ["sha1", "sha256", "sha512", "murmur2"]},
        "filename": {"type": "string", "minLength": 1},
        "metadata_path": {"pattern": "^mods/[a-z0-9-]+\\.pw\\.toml$"},
        "metadata_sha256": {"pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
