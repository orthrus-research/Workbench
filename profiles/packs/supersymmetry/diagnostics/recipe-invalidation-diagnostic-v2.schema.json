{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workbench.invalid/schemas/supersymmetry-recipe-invalidation-diagnostic-v2.schema.json",
  "title": "Supersymmetry recipe invalidation diagnostic V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schema_version",
    "diagnostic_id",
    "operation_class",
    "authority",
    "state",
    "profile",
    "source",
    "channels",
    "recommendation",
    "limitations"
  ],
  "properties": {
    "format": {
      "const": "workbench-supersymmetry-recipe-invalidation-diagnostic-v2"
    },
    "schema_version": {
      "const": 2
    },
    "diagnostic_id": {
      "$ref": "#/$defs/sha256Id"
    },
    "operation_class": {
      "const": "read-only"
    },
    "authority": {
      "$ref": "#/$defs/authority"
    },
    "state": {
      "enum": [
        "attention",
        "attention-incomplete",
        "inconclusive",
        "no-supported-signals-observed"
      ]
    },
    "profile": {
      "$ref": "#/$defs/boundObject"
    },
    "source": {
      "$ref": "#/$defs/boundObject"
    },
    "channels": {
      "$ref": "#/$defs/channels"
    },
    "recommendation": {
      "$ref": "#/$defs/recommendation"
    },
    "limitations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonempty"
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "nonempty": {
      "type": "string",
      "minLength": 1
    },
    "sha256Id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "boundObject": {
      "type": "object",
      "minProperties": 1
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "owner",
        "normative",
        "atlas_publication"
      ],
      "properties": {
        "classification": {
          "$ref": "#/$defs/nonempty"
        },
        "owner": {
          "$ref": "#/$defs/nonempty"
        },
        "normative": {
          "const": false
        },
        "atlas_publication": {
          "const": false
        }
      }
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "summary",
        "actions"
      ],
      "properties": {
        "state": {
          "$ref": "#/$defs/nonempty"
        },
        "summary": {
          "$ref": "#/$defs/nonempty"
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonempty"
          }
        }
      }
    },
    "channelDiagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "schema_version",
        "diagnostic_id",
        "operation_class",
        "authority",
        "state",
        "profile",
        "source",
        "scope",
        "summary",
        "groups",
        "frontiers",
        "recommendation",
        "limitations"
      ],
      "properties": {
        "format": {
          "$ref": "#/$defs/nonempty"
        },
        "schema_version": {
          "const": 1
        },
        "diagnostic_id": {
          "$ref": "#/$defs/sha256Id"
        },
        "operation_class": {
          "const": "read-only"
        },
        "authority": {
          "$ref": "#/$defs/authority"
        },
        "state": {
          "$ref": "#/$defs/nonempty"
        },
        "profile": {
          "$ref": "#/$defs/boundObject"
        },
        "source": {
          "$ref": "#/$defs/boundObject"
        },
        "scope": {
          "$ref": "#/$defs/boundObject"
        },
        "summary": {
          "type": "object",
          "minProperties": 1,
          "required": [
            "group_count",
            "emitted_group_count",
            "groups_truncated",
            "incomplete_sequence_count",
            "emitted_frontier_count",
            "frontiers_truncated"
          ],
          "properties": {
            "group_count": {
              "type": "integer",
              "minimum": 0
            },
            "emitted_group_count": {
              "type": "integer",
              "minimum": 0
            },
            "groups_truncated": {
              "type": "boolean"
            },
            "incomplete_sequence_count": {
              "type": "integer",
              "minimum": 0
            },
            "emitted_frontier_count": {
              "type": "integer",
              "minimum": 0
            },
            "frontiers_truncated": {
              "type": "boolean"
            }
          }
        },
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/boundObject"
          }
        },
        "frontiers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/boundObject"
          }
        },
        "recommendation": {
          "$ref": "#/$defs/recommendation"
        },
        "limitations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonempty"
          },
          "uniqueItems": true
        }
      }
    },
    "nonnegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1
    },
    "groovyDiagnosticGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "script_logger",
        "recipe_map",
        "counts",
        "resolutions",
        "first_line",
        "last_line",
        "examples"
      ],
      "properties": {
        "kind": {
          "const": "gt-recipe-duplicate-or-conflict"
        },
        "script_logger": {
          "$ref": "#/$defs/nonempty"
        },
        "recipe_map": {
          "$ref": "#/$defs/nonempty"
        },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "total",
            "initial",
            "reload",
            "unbound"
          ],
          "properties": {
            "total": {
              "$ref": "#/$defs/positiveInteger"
            },
            "initial": {
              "$ref": "#/$defs/nonnegativeInteger"
            },
            "reload": {
              "$ref": "#/$defs/nonnegativeInteger"
            },
            "unbound": {
              "$ref": "#/$defs/nonnegativeInteger"
            }
          }
        },
        "resolutions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "exact-conflict",
            "conflict-not-identified"
          ],
          "properties": {
            "exact-conflict": {
              "$ref": "#/$defs/nonnegativeInteger"
            },
            "conflict-not-identified": {
              "$ref": "#/$defs/nonnegativeInteger"
            }
          }
        },
        "first_line": {
          "$ref": "#/$defs/positiveInteger"
        },
        "last_line": {
          "$ref": "#/$defs/positiveInteger"
        },
        "examples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/boundObject"
          }
        }
      }
    },
    "gtDiagnosticGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "reason_code",
        "observed_owner_class",
        "observed_owner_method",
        "count",
        "first_line",
        "last_line",
        "examples",
        "context_count",
        "emitted_context_count",
        "contexts_truncated",
        "contexts"
      ],
      "properties": {
        "kind": {
          "const": "gt-recipe-registration"
        },
        "reason_code": {
          "enum": [
            "empty-recipe-outputs",
            "duplicate-furnace-recipe"
          ]
        },
        "observed_owner_class": {
          "$ref": "#/$defs/nonempty"
        },
        "observed_owner_method": {
          "$ref": "#/$defs/nonempty"
        },
        "count": {
          "$ref": "#/$defs/positiveInteger"
        },
        "first_line": {
          "$ref": "#/$defs/positiveInteger"
        },
        "last_line": {
          "$ref": "#/$defs/positiveInteger"
        },
        "examples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/boundObject"
          }
        },
        "context_count": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "emitted_context_count": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "contexts_truncated": {
          "type": "boolean"
        },
        "contexts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/boundObject"
          }
        }
      }
    },
    "channels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "groovy_postinit",
        "gt_startup_registration"
      ],
      "properties": {
        "groovy_postinit": {
          "allOf": [
            {
              "$ref": "#/$defs/channelDiagnostic"
            },
            {
              "properties": {
                "format": {
                  "const": "workbench-supersymmetry-recipe-reload-diagnostic-v1"
                },
                "state": {
                  "enum": [
                    "attention",
                    "inconclusive",
                    "no-groovy-conflicts-observed"
                  ]
                },
                "groups": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/groovyDiagnosticGroup"
                  }
                }
              }
            }
          ]
        },
        "gt_startup_registration": {
          "allOf": [
            {
              "$ref": "#/$defs/channelDiagnostic"
            },
            {
              "properties": {
                "format": {
                  "const": "workbench-supersymmetry-gt-recipe-registration-diagnostic-v1"
                },
                "state": {
                  "enum": [
                    "attention",
                    "inconclusive",
                    "no-signals-observed"
                  ]
                },
                "groups": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/gtDiagnosticGroup"
                  }
                }
              }
            }
          ]
        }
      }
    }
  }
}
