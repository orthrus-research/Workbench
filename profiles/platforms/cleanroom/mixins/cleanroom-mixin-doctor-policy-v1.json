  "uncertainties": [
    {
      "id": "runtime-service-selection",
      "resolution": "Require a runtime receipt that enumerates selected service providers.",
      "statement": "Static source establishes the expected native service but does not prove which provider a particular process selected."
    },
    {
      "id": "connector-output",
      "resolution": "Observe or instrument connector execution and bind every added configuration.",
      "statement": "Static class inspection may not enumerate configurations assembled dynamically by MixinConnector."
    },
    {
      "id": "plugin-and-connector-dependency-closure",
      "resolution": "Add explicit artifact dependency roles, class-resolution edges, class-header inheritance, and connector interface retention before making a terminal missing-class or interface decision.",
      "statement": "A class absent from its owning archive may be supplied by a declared dependency, and a direct interface table does not close superclass inheritance."
    },
    {
      "id": "plugin-decisions",
      "resolution": "Record plugin decisions and active mod inventory in a runtime observation.",
      "statement": "The presence of IMixinConfigPlugin does not prove its shouldApplyMixin decisions."
    },
    {
      "id": "relocation-identification",
      "resolution": "Inventory relocated dependencies with byte or source provenance.",
      "statement": "A package-prefix scan proves original namespace duplication but cannot always identify a relocated implementation."
    }
